---
/** Device-frame viewer: /compare/?c=a&device=mobile&lang=es */
import '@fontsource-variable/instrument-sans/wght.css';
import Base from '../../layouts/Base.astro';
import { CONCEPTS } from '../../data/concepts';
import { url } from '../../i18n';
const base = url('');
---
<Base lang="es" path="compare/" title="Ceviche House — Vista previa" bodyClass="vw" indexable={false} jsonLd={false} alternates={false} themeColor="#101418">
  <header class="vw__bar">
    <a class="vw__back" href={url('concepts/')}>← Conceptos</a>
    <div class="vw__grp" role="group" aria-label="Concepto">
      {CONCEPTS.map((c) => <button type="button" data-c={c.id}>{c.id.toUpperCase()} · {c.name}</button>)}
    </div>
    <div class="vw__grp" role="group" aria-label="Dispositivo">
      <button type="button" data-d="desktop">Desktop</button>
      <button type="button" data-d="tablet">Tablet</button>
      <button type="button" data-d="mobile">Mobile</button>
    </div>
    <div class="vw__grp" role="group" aria-label="Idioma">
      <button type="button" data-l="es">ES</button>
      <button type="button" data-l="en">EN</button>
    </div>
    <a class="vw__open" id="vw-open" href="#">Abrir ↗</a>
  </header>
  <main class="vw__stage" id="main">
    <div class="vw__device" id="vw-device"><iframe id="vw-frame" title="Vista previa del concepto"></iframe></div>
  </main>
  <script is:inline define:vars={{ base }}>
    const q = new URLSearchParams(location.search);
    const st = { c: q.get('c') || 'a', d: q.get('device') || 'desktop', l: q.get('lang') || 'es' };
    const frame = document.getElementById('vw-frame'), dev = document.getElementById('vw-device'), open = document.getElementById('vw-open');
    function render() {
      const src = base + (st.l === 'en' ? 'en/' : '') + 'concept-' + st.c + '/';
      if (frame.getAttribute('src') !== src) frame.setAttribute('src', src);
      open.href = src; dev.dataset.device = st.d;
      document.querySelectorAll('[data-c]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.c === st.c));
      document.querySelectorAll('[data-d]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.d === st.d));
      document.querySelectorAll('[data-l]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.l === st.l));
      history.replaceState(null, '', '?c=' + st.c + '&device=' + st.d + '&lang=' + st.l);
    }
    document.addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      if (b.dataset.c) st.c = b.dataset.c; if (b.dataset.d) st.d = b.dataset.d; if (b.dataset.l) st.l = b.dataset.l;
      render();
    });
    render();
  </script>
</Base>
<style is:global>
  .vw { background: #101418; color: #eef0f2; font: 500 .9rem/1.4 'Instrument Sans Variable', system-ui, sans-serif; height: 100vh; display: flex; flex-direction: column; }
  .vw__bar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; padding: .7rem 1rem; border-bottom: 1px solid rgb(255 255 255 / .1); }
  .vw__back, .vw__open { text-decoration: none; padding: .55rem .4rem; }
  .vw__open { margin-left: auto; }
  .vw__grp { display: flex; gap: 2px; background: rgb(255 255 255 / .06); border-radius: 999px; padding: 3px; overflow-x: auto; max-width: 100%; }
  .vw__grp button { flex: none; border: 0; background: none; padding: .5rem .85rem; border-radius: 999px; font-size: .82rem; }
  .vw__grp button[aria-pressed='true'] { background: #eef0f2; color: #101418; }
  .vw__stage { flex: 1; display: grid; place-items: center; padding: 1.2rem; overflow: auto; }
  .vw__device { width: 100%; height: 100%; background: #000; border-radius: 10px; overflow: hidden; transition: width .4s, height .4s; }
  .vw__device[data-device='tablet'] { width: 820px; height: min(1100px, 100%); max-width: 100%; border-radius: 26px; border: 10px solid #000; }
  .vw__device[data-device='mobile'] { width: 390px; height: min(844px, 100%); max-width: 100%; border-radius: 42px; border: 10px solid #000; }
  .vw__device iframe { width: 100%; height: 100%; border: 0; background: #fff; }
</style>
