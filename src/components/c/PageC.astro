---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Photo from '../shared/Photo.astro';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { GALLERY, PHOTOS } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const nav = [
  ['#story', s.nav.story], ['#menu', s.nav.menu], ['#gallery', s.nav.gallery],
  ['#reviews', s.nav.reviews], ['#locations', s.nav.locations],
] as const;
const name = (o: { es: string; en: string }) => o[lang];
const n2 = (i: number) => String(i).padStart(2, '0');
---
<Base lang={lang} path={path} bodyClass="cC" indexable={indexable} canonicalPath={canonicalPath} themeColor="#f7f5f0">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <div class="hd__in">
      <a class="brand" href="#top">Ceviche House</a>
      <nav class="hd__nav" aria-label="Principal">
        {nav.map(([h, l], i) => <a href={h}><sup>{n2(i + 1)}</sup>{l}</a>)}
      </nav>
      <div class="hd__right">
        <a class="lang" href={switchHref} hreflang={other} aria-label={s.switchLabel}>
          <span class:list={[{ on: lang === 'es' }]}>ES</span> <span class:list={[{ on: lang === 'en' }]}>EN</span>
        </a>
        <a class="hd__cta" href={wa} target="_blank" rel="noopener">{s.reserve}<Icon name="arrow" size={16} /></a>
        <button class="tog" type="button" data-nav-toggle aria-controls="c-menu" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
          <span class="tog__t">Menu</span><span class="tog__i" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <div class="drop" id="c-menu">
      <nav aria-label="Móvil">
        <a href="#top"><span>00</span>{s.nav.home}</a>
        {nav.map(([h, l], i) => <a href={h}><span>{n2(i + 1)}</span>{l}</a>)}
      </nav>
      <div class="drop__foot">
        <a class="btn btn--navy" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
        <a class="drop__lang" href={switchHref} hreflang={other}>{s.switchTo}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="grid">
        <p class="hero__meta mono">Lima — {lang === 'es' ? 'Perú' : 'Peru'}</p>
        <p class="hero__meta hero__meta--r mono">{s.eyebrow}</p>
        <h1 class="hero__title" data-reveal>
          {lang === 'es'
            ? <Fragment>Ceviche, <i>sin prisa</i><br />y al momento.</Fragment>
            : <Fragment>Ceviche, <i>unhurried</i><br />and made to order.</Fragment>}
        </h1>
      </div>
      <div class="grid hero__below">
        <div class="hero__side">
          <p class="hero__lead">{s.heroLead}</p>
          <div class="hero__cta">
            <a class="btn btn--navy" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveLong}</a>
            <a class="btn btn--line" href="#menu">{s.exploreMenu}</a>
          </div>
          <dl class="hero__idx">
            {LOCATIONS.map((l, i) => <div><dt class="mono">{n2(i + 1)} · {l.name}</dt><dd>{l.street}</dd></div>)}
          </dl>
        </div>
        <figure class="hero__img">
          <Photo src={PHOTOS.ceviche} alt={GALLERY[0][lang]} eager sizes="(min-width: 900px) 62vw, 100vw" widths={[640, 1080]} position="center 45%" />
        </figure>
      </div>
    </section>

    <!-- STORY -->
    <section class="sec" id="story">
      <div class="grid">
        <p class="label mono">(01) {s.storyKicker}</p>
        <div class="story">
          <h2 class="h2" data-reveal>{s.storyTitle}</h2>
          <div class="story__cols" data-reveal>
            <p>{s.storyP1}</p>
            <p>{s.storyP2}</p>
            <p>{s.storyP3}</p>
          </div>
        </div>
      </div>
      <div class="grid">
        <ul class="pillars">
          {s.pillars.map((p, i) => (
            <li data-reveal><span class="mono">{n2(i + 1)}</span><h3>{p.t}</h3><p>{p.d}</p></li>
          ))}
        </ul>
      </div>
      <div class="grid story__pair">
        <figure class="story__img" data-reveal>
          <Photo src={PHOTOS.mariscos} alt={GALLERY[2][lang]} sizes="(min-width: 900px) 50vw, 100vw" />
        </figure>
        <blockquote class="story__q" data-reveal><p>{s.quote}</p></blockquote>
      </div>
    </section>

    <!-- SIGNATURE DISHES -->
    <section class="sec sec--tint" id="dishes">
      <div class="grid">
        <p class="label mono">(02) {s.dishesKicker}</p>
        <div class="sec__head">
          <h2 class="h2" data-reveal>{s.dishesTitle}</h2>
          <p class="muted">{s.dishesLead}</p>
        </div>
      </div>
      <div class="grid">
        <ol class="tbl">
          {dishes.map((d, i) => (
            <li class="tbl__row" data-reveal>
              <span class="tbl__n mono">{n2(i + 1)}</span>
              <h3 class="tbl__name">{d.name}</h3>
              <p class="tbl__desc">{d.desc}</p>
              <span class="tbl__cat mono">{d.category}</span>
              <span class="tbl__price">{d.price}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FULL MENU -->
    <section class="sec" id="menu" data-menu>
      <div class="grid">
        <p class="label mono">(03) {s.fullMenuKicker}</p>
        <div class="sec__head">
          <h2 class="h2">{s.fullMenuTitle}</h2>
          <p class="muted">{s.fullMenuLead}</p>
        </div>
      </div>
      <div class="grid menu">
        <aside class="menu__side">
          <div class="menu__cats" role="group" aria-label={s.fullMenuTitle}>
            <button type="button" data-filter="all" aria-pressed="true"><span class="mono">00</span>{s.allCats}</button>
            {MENU.map((c, i) => <button type="button" data-filter={c.id} aria-pressed="false"><span class="mono">{n2(i + 1)}</span>{name(c)}</button>)}
          </div>
          <div class="menu__pdf">
            <a class="btn btn--navy btn--sm" href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={16} />{s.menuPdf}</a>
            <a class="btn btn--line btn--sm" href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={16} />{s.menuPdfOther}</a>
          </div>
        </aside>
        <div class="menu__list">
          {MENU.map((c, i) => (
            <section class="mcat" data-cat={c.id} aria-labelledby={`c-cat-${c.id}`}>
              <h3 id={`c-cat-${c.id}`}><span class="mono">{n2(i + 1)}</span>{name(c)}</h3>
              <ul>
                {c.items.map((it) => (
                  <li>
                    <span>{name(it)}{(lang === 'es' ? it.subEs : it.subEn) && <small>{lang === 'es' ? it.subEs : it.subEn}</small>}</span>
                    <i aria-hidden="true"></i>
                    <span class="mono">{priceOf(it, lang)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <p class="muted mono menu__note">S/ — {lang === 'es' ? 'soles peruanos' : 'Peruvian soles'}</p>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="sec sec--dark" id="gallery">
      <div class="grid">
        <p class="label mono">(04) {s.galleryKicker}</p>
        <div class="sec__head">
          <h2 class="h2" data-reveal>{s.galleryTitle}</h2>
          <p class="gal__social">
            <a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok <Icon name="external" size={14} /></a>
            <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook <Icon name="external" size={14} /></a>
            {SOCIAL.instagram && <a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram <Icon name="external" size={14} /></a>}
          </p>
        </div>
      </div>
      <div class="grid">
        <div class="gal">
          {GALLERY.map((g, i) => (
            <figure class={`gal__it gal__it--${i}`} data-reveal>
              <div class="gal__frame">
                {g.src ? (
                  <a href={PHOTOS[g.key as 'ceviche' | 'mariscos'].src} data-lightbox data-alt={g[lang]} aria-label={g[lang]}>
                    <Photo src={g.src} alt={g[lang]} sizes="(min-width: 900px) 33vw, 100vw" />
                  </a>
                ) : (
                  <Photo src={null} alt={g[lang]} label={s.photoSoon} tone="dark" />
                )}
              </div>
              <figcaption class="mono">{n2(i + 1)} — {g[lang]}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section class="sec" id="reviews">
      <div class="grid">
        <p class="label mono">(05) {s.reviewsKicker}</p>
        <div class="sec__head">
          <h2 class="h2" data-reveal>{s.reviewsTitle}</h2>
          <p class="muted">{s.reviewsLead}</p>
        </div>
      </div>
      <div class="grid">
        <ul class="rev">
          {REVIEWS.map((r) => (
            <li class="rev__row" data-reveal>
              <span class="mono">{s.platform[r.platform]}</span>
              <h3>{LOCATIONS.find((l) => l.id === r.location)!.name}</h3>
              <div class="rev__body">
                {r.rating != null
                  ? <p class="rev__score">{r.rating.toFixed(1)} <small class="mono">/ 5{r.count != null && ` — ${r.count} ${s.reviewsCount}`}</small></p>
                  : <p class="muted">{s.noRatingYet}</p>}
                {r.platform === 'tripadvisor' && <p class="rev__note">{s.tripNote}</p>}
                {r.quotes.map((q) => <blockquote><p>“{q.text}”</p><footer class="mono">{q.author} — {q.date}</footer></blockquote>)}
              </div>
              <div class="rev__links">
                <a href={r.url} target="_blank" rel="noopener">{s.readReviews} <Icon name="arrow" size={16} /></a>
                {r.writeUrl && <a href={r.writeUrl} target="_blank" rel="noopener">{s.writeReview}</a>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- LOCATIONS -->
    <section class="sec sec--tint" id="locations">
      <div class="grid">
        <p class="label mono">(06) {s.locationsKicker}</p>
        <div class="sec__head">
          <h2 class="h2" data-reveal>{s.locationsTitle}</h2>
          <p class="muted">{s.locationsLead}</p>
        </div>
      </div>
      <div class="grid locs">
        {LOCATIONS.map((l, i) => (
          <article class="loc" data-reveal>
            <div class="loc__map">
              <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`Mapa — Ceviche House ${l.name}`}>
                <span class="mono">{n2(i + 1)}</span><b>{s.loadMap}</b><small>{s.mapPrivacy}</small>
              </button>
            </div>
            <h3 class="loc__name">{l.name}</h3>
            <dl class="loc__dl">
              <div><dt class="mono">{lang === 'es' ? 'Dirección' : 'Address'}</dt><dd>{l.street}, {l.district}, Lima</dd></div>
              <div><dt class="mono">{lang === 'es' ? 'Reservas' : 'Bookings'}</dt><dd><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></dd></div>
              <div><dt class="mono">{lang === 'es' ? 'Horario' : 'Hours'}</dt><dd>{l.hours ? l.hours[lang] : s.hoursAsk}</dd></div>
            </dl>
            <div class="loc__btns">
              <a class="btn btn--navy btn--sm" href={whatsappLink(lang, l.id)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{s.reserveHere} {l.name}</a>
              <a class="btn btn--line btn--sm" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener">{s.directions}</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="grid">
      <div class="ft__cta">
        <h2 class="ft__title">{s.footerReserve}</h2>
        <a class="btn btn--sage" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      </div>
      <div class="ft__cols">
        <div><p class="mono">Ceviche House</p><p>{s.footerTag}</p></div>
        {LOCATIONS.map((l) => <div><p class="mono">{l.name}</p><address>{l.street}<br />{l.district}, Lima</address></div>)}
        <div>
          <p class="mono">{s.follow}</p>
          <a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
          {SOCIAL.instagram && <a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a>}
        </div>
        <div>
          <p class="mono">{s.menus}</p>
          <a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a>
          <a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a>
          <a href={switchHref} hreflang={other}>{s.switchTo}</a>
        </div>
      </div>
      <p class="ft__legal mono">© {new Date().getFullYear()} Ceviche House — {s.rights}</p>
    </div>
  </footer>

  <a class="fab" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />{s.reserve}</a>
</Base>

<style is:global>
  .cC {
    --ivory: #f7f5f0; --stone: #ecE8df; --graphite: #2b2b2b; --navy: #14213d; --sage: #8a9a84; --sage-d: #526249; --line: rgb(43 43 43 / .16); --muted: #63625e;
    --serif: 'Instrument Serif', 'Times New Roman', serif; --sans: 'Manrope Variable', system-ui, sans-serif;
    --gut: clamp(1rem, 3.5vw, 2.5rem); --max: 1400px;
    background: var(--ivory); color: var(--graphite); font: 400 1rem/1.65 var(--sans);
  }
  .cC .mono { font: 600 .7rem/1.4 var(--sans); letter-spacing: .14em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .cC .muted { color: var(--muted); }
  .cC .grid { max-width: var(--max); margin: auto; padding-inline: var(--gut); display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 1.5rem; }
  @media (min-width: 900px) { .cC .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); } }
  .cC .h2 { font: 400 clamp(2.4rem, 5.4vw, 4.6rem)/1 var(--serif); letter-spacing: -.015em; color: var(--navy); text-wrap: balance; }

  .cC .btn { display: inline-flex; align-items: center; gap: .55rem; min-height: 48px; padding: .75rem 1.3rem; font: 600 .9rem/1 var(--sans); text-decoration: none; border: 1px solid transparent; border-radius: 0; transition: background .3s, color .3s, border-color .3s; }
  .cC .btn--sm { min-height: 42px; padding: .55rem 1rem; font-size: .84rem; }
  .cC .btn--navy { background: var(--navy); color: var(--ivory); }
  .cC .btn--navy:hover { background: var(--graphite); }
  .cC .btn--line { border-color: var(--navy); color: var(--navy); }
  .cC .btn--line:hover { background: var(--navy); color: var(--ivory); }
  .cC .btn--sage { background: var(--sage); color: var(--navy); }
  .cC .btn--sage:hover { background: var(--ivory); }

  /* Header */
  .cC .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--ivory) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .cC .hd[data-scrolled] { border-color: var(--line); }
  .cC .hd__in { max-width: var(--max); margin: auto; padding: 0 var(--gut); height: 64px; display: flex; align-items: center; gap: 2rem; }
  .cC .brand { font: 400 1.55rem/1 var(--serif); text-decoration: none; color: var(--navy); letter-spacing: -.01em; }
  .cC .hd__nav { display: none; gap: 1.8rem; margin-inline: auto; }
  .cC .hd__nav a { font-size: .86rem; font-weight: 500; text-decoration: none; display: inline-flex; gap: .3rem; padding: .5rem 0; }
  .cC .hd__nav sup { font-size: .6rem; color: var(--sage-d); font-weight: 700; }
  .cC .hd__nav a:hover { color: var(--navy); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .cC .hd__right { margin-left: auto; display: flex; align-items: center; gap: 1.2rem; }
  .cC .lang { font: 700 .72rem/1 var(--sans); letter-spacing: .12em; text-decoration: none; color: var(--muted); padding: .8rem .2rem; }
  .cC .lang .on { color: var(--navy); }
  .cC .hd__cta { display: none; align-items: center; gap: .4rem; font-weight: 700; font-size: .86rem; color: var(--navy); text-decoration: none; padding: .55rem 1rem; border: 1px solid var(--navy); transition: background .3s, color .3s; }
  .cC .hd__cta:hover { background: var(--navy); color: var(--ivory); }
  .cC .tog { display: flex; align-items: center; gap: .6rem; background: none; border: 0; min-height: 44px; padding: 0 .2rem; font: 700 .72rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .cC .tog__i { width: 20px; height: 8px; border-block: 1.5px solid var(--graphite); transition: height .3s; }
  .cC .tog[aria-expanded='true'] .tog__i { height: 0; border-bottom: 0; }
  @media (min-width: 1024px) { .cC .hd__nav, .cC .hd__cta { display: inline-flex; } .cC .tog { display: none; } }
  .cC .drop { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .45s cubic-bezier(.2,.7,.2,1); border-top: 1px solid transparent; }
  .cC .drop > * { overflow: hidden; }
  .cC .drop[data-open] { grid-template-rows: 1fr; border-color: var(--line); }
  .cC .drop nav { display: grid; padding: 0 var(--gut); min-height: 0; }
  .cC .drop nav a { display: flex; gap: 1rem; align-items: baseline; text-decoration: none; font: 400 1.9rem/1.3 var(--serif); padding: .6rem 0; border-bottom: 1px solid var(--line); color: var(--navy); }
  .cC .drop nav span { font: 600 .68rem/1 var(--sans); letter-spacing: .14em; color: var(--sage-d); }
  .cC .drop__foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 var(--gut); min-height: 0; }
  .cC .drop[data-open] nav { padding-top: .5rem; }
  .cC .drop[data-open] .drop__foot { padding-block: 1.2rem 1.5rem; }
  .cC .drop__lang { font-weight: 700; font-size: .9rem; padding: .7rem 0; }
  .cC .drop:not([data-open]) { visibility: hidden; }

  /* Hero */
  .cC .hero { padding-top: clamp(2rem, 5vw, 4rem); }
  .cC .hero__meta { color: var(--muted); grid-column: 1 / -1; }
  .cC .hero__meta--r { display: none; }
  .cC .hero__title { grid-column: 1 / -1; font: 400 clamp(3.2rem, 8vw, 7.4rem)/.92 var(--serif); letter-spacing: -.03em; color: var(--navy); margin: 1rem 0 clamp(2rem, 4vw, 3.5rem); }
  .cC .hero__title i { color: var(--sage-d); }
  .cC .hero__img { margin-inline: calc(-1 * var(--gut)); }
  .cC .hero__img picture, .cC .hero__img .ph { aspect-ratio: 1; }
  .cC .hero__img img { animation: cFade 1.6s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes cFade { from { opacity: 0; clip-path: inset(8% 0 0 0); } to { opacity: 1; clip-path: inset(0); } }
  .cC .hero__below { padding-bottom: clamp(4rem, 8vw, 7rem); row-gap: 2rem; }
  .cC .hero__side { display: grid; gap: 2rem; align-content: end; order: 2; }
  .cC .hero__lead { font-size: 1.1rem; max-width: 30rem; }
  .cC .hero__cta { display: flex; flex-wrap: wrap; gap: .6rem; }
  .cC .hero__idx { display: grid; gap: 1rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .cC .hero__idx dt { color: var(--sage-d); }
  @media (min-width: 900px) {
    .cC .hero__meta { grid-column: 1 / 7; }
    .cC .hero__meta--r { display: block; grid-column: 7 / 13; text-align: right; }
    .cC .hero__side { grid-column: 1 / 5; order: 0; }
    .cC .hero__img { grid-column: 5 / 13; margin: 0; }
    .cC .hero__img picture { aspect-ratio: 16 / 11; }
  }

  /* Sections */
  .cC .sec { padding-block: clamp(4.5rem, 9vw, 8rem); border-top: 1px solid var(--line); }
  .cC .sec--tint { background: var(--stone); }
  .cC .sec--dark { background: var(--navy); color: var(--ivory); border: 0; }
  .cC .sec--dark .h2 { color: var(--ivory); }
  .cC .label { color: var(--sage-d); grid-column: 1 / -1; margin-bottom: 1.5rem; }
  .cC .sec--dark .label { color: var(--sage); }
  .cC .sec__head { grid-column: 1 / -1; display: grid; gap: 1rem; margin-bottom: 3rem; }
  @media (min-width: 900px) {
    .cC .label { grid-column: 1 / 4; margin: .9rem 0 0; }
    .cC .sec__head { grid-column: 4 / 13; grid-template-columns: 1.4fr 1fr; align-items: end; gap: 2rem; }
  }

  /* Story */
  .cC .story { grid-column: 1 / -1; display: grid; gap: 2.5rem; }
  .cC .story__cols { display: grid; gap: 1.2rem; color: #3e3e3c; }
  @media (min-width: 900px) { .cC .story { grid-column: 4 / 13; } .cC .story__cols { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
