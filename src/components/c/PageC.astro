---
/**
 * Concept C — Minimal Contemporary ("Mesa").
 * A calm, numbered index on warm stone paper. Structure from a 12-column grid
 * and hairlines; warmth from stone/olive tones, italic serif and large photos.
 * Instrument Serif + Instrument Sans (one type family, two voices).
 */
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../../styles/tokens.css';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Photo from '../shared/Photo.astro';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { P, IG } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const nav = [
  ['#story', s.nav.story], ['#dishes', s.nav.menu], ['#gallery', s.nav.gallery],
  ['#locations', s.nav.locations], ['#reviews', s.nav.reviews],
] as const;
const name = (o: { es: string; en: string }) => o[lang];
const nn = (i: number) => String(i).padStart(2, '0');
---
<Base lang={lang} path={path} bodyClass="cC" indexable={indexable} canonicalPath={canonicalPath} themeColor="#f9f9f7">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <div class="hd__in">
      <a class="brand" href="#top">Ceviche House</a>
      <nav class="hd__nav" aria-label={es ? 'Principal' : 'Main'}>
        {nav.map(([h, l], i) => <a href={h}><i>{nn(i + 1)}</i>{l}</a>)}
      </nav>
      <a class="lang" href={switchHref} hreflang={other} aria-label={s.switchLabel}>{other.toUpperCase()}</a>
      <a class="btn btn--line btn--sm hd__cta" href={wa} target="_blank" rel="noopener">{s.reserve}<Icon name="arrow" size={16} /></a>
      <button class="mbtn" type="button" data-nav-toggle aria-controls="c-menu" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
        <span class="mbtn__o">{es ? 'Menú' : 'Menu'}</span><span class="mbtn__c">{es ? 'Cerrar' : 'Close'}</span>
      </button>
    </div>
    <div class="dd" id="c-menu">
      <nav aria-label={es ? 'Móvil' : 'Mobile'}>
        {nav.map(([h, l], i) => <a href={h}><i>{nn(i + 1)}</i>{l}</a>)}
      </nav>
      <a class="btn btn--ink" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      <a class="dd__lang" href={switchHref} hreflang={other}>{s.switchTo}</a>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="g hero__g">
        <p class="hero__meta">Lima — Perú</p>
        <p class="hero__meta hero__meta--r">{s.eyebrow}</p>
        <h1 class="hero__title">{es
          ? <Fragment>Ceviche, <em>sin prisa</em> y al momento.</Fragment>
          : <Fragment>Ceviche, <em>unhurried</em> and made to order.</Fragment>}</h1>
        <div class="hero__side">
          <p class="hero__lead">{s.heroLead}</p>
          <div class="hero__cta">
            <a class="btn btn--ink" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveLong}</a>
            <a class="btn btn--line" href="#menu">{s.exploreMenu}</a>
          </div>
        </div>
        <figure class="hero__fig">
          <div class="hero__img"><Photo src={IG.huarique.src} alt={IG.huarique[lang]} eager sizes="(min-width: 900px) 62vw, 100vw" position={IG.huarique.focus} /></div>
        </figure>
      </div>
      <dl class="g facts">
        {LOCATIONS.map((l, i) => <div><dt><i>{nn(i + 1)}</i>{l.name}</dt><dd>{l.street}</dd></div>)}
        <div><dt><i>03</i>{es ? 'Reservas' : 'Bookings'}</dt><dd><a href={wa} target="_blank" rel="noopener">WhatsApp {PHONE_DISPLAY}</a></dd></div>
        <div><dt><i>04</i>{s.nav.menu}</dt><dd><a href={MENU_PDF[lang]} target="_blank" rel="noopener">{s.menuPdf}</a></dd></div>
      </dl>
    </section>

    <!-- 01 STORY -->
    <section class="sec" id="story">
      <div class="g">
        <p class="lab" data-reveal><i>01</i>{s.storyKicker}</p>
        <div class="story__main" data-reveal>
          <h2 class="h2">{s.storyTitle}</h2>
          <p class="story__lede">{s.storyP1}</p>
          <div class="story__cols"><p>{s.storyP2}</p><p>{s.storyP3}</p></div>
        </div>
        <figure class="story__fig" data-reveal>
          <div class="sq"><Photo src={P.mariscosDetalle.src} alt={P.mariscosDetalle[lang]} sizes="(min-width: 900px) 24vw, 60vw" /></div>
          <figcaption>{P.mariscosDetalle[lang]}</figcaption>
        </figure>
        <dl class="defs" data-reveal>
          {s.pillars.map((p) => <div><dt>{p.t}</dt><dd>{p.d}</dd></div>)}
        </dl>
      </div>
    </section>

    <!-- 02 DISHES -->
    <section class="sec sec--stone" id="dishes">
      <div class="g">
        <p class="lab" data-reveal><i>02</i>{s.dishesKicker}</p>
        <div class="dishes__head" data-reveal>
          <h2 class="h2">{s.dishesTitle}</h2>
          <p>{s.dishesLead}</p>
        </div>
        <figure class="dishes__fig">
          <div class="dishes__img"><Photo src={IG.ceviche.src} alt={IG.ceviche[lang]} sizes="(min-width: 900px) 30vw, 100vw" position={IG.ceviche.focus} /></div>
          <figcaption>{IG.ceviche[lang]}</figcaption>
        </figure>
        <ol class="rows">
          {dishes.map((d, i) => (
            <li data-reveal>
              <span class="rows__n">{nn(i + 1)}</span>
              <h3>{d.name}</h3>
              <p>{d.desc}</p>
              <span class="rows__p">{d.price}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 03 MENU -->
    <section class="sec" id="menu" data-menu data-menu-default="ceviches">
      <div class="g">
        <p class="lab"><i>03</i>{s.fullMenuKicker}</p>
        <div class="menu__head">
          <h2 class="h2">{s.fullMenuTitle}</h2>
          <p>{s.fullMenuLead}</p>
        </div>
        <div class="menu__side">
          <div class="menu__nav" role="group" aria-label={s.fullMenuTitle}>
            <button type="button" data-filter="all" aria-pressed="true"><i>00</i>{s.allCats}</button>
            {MENU.map((c, i) => <button type="button" data-filter={c.id} aria-pressed="false"><i>{nn(i + 1)}</i>{name(c)}</button>)}
          </div>
          <p class="menu__pdf">
            <a href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={16} />{s.menuPdf}</a>
            <a href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={16} />{s.menuPdfOther}</a>
          </p>
        </div>
        <div class="menu__cols">
          {MENU.map((c, i) => (
            <section class="mcat" data-cat={c.id} aria-labelledby={`c-cat-${c.id}`}>
              <h3 id={`c-cat-${c.id}`}><i>{nn(i + 1)}</i>{name(c)}</h3>
              <ul>
                {c.items.map((it) => (
                  <li><span>{name(it)}{(es ? it.subEs : it.subEn) && <small>{es ? it.subEs : it.subEn}</small>}</span><b>{priceOf(it, lang)}</b></li>
                ))}
              </ul>
            </section>
          ))}
          <p class="menu__note">{s.menuNote}</p>
        </div>
      </div>
    </section>

    <!-- 04 GALLERY -->
    <section class="sec sec--stone" id="gallery">
      <div class="g">
        <p class="lab" data-reveal><i>04</i>{s.galleryKicker}</p>
        <h2 class="h2 gal__title" data-reveal>{s.galleryTitle}</h2>
        <figure class="gal__f gal__f--a" data-reveal>
          <a href={IG.casona.src.src} data-lightbox data-alt={IG.casona[lang]}><Photo src={IG.casona.src} alt={IG.casona[lang]} sizes="(min-width: 900px) 46vw, 100vw" position={IG.casona.focus} /></a>
          <figcaption><i>4.1</i>{IG.casona[lang]}</figcaption>
        </figure>
        <figure class="gal__f gal__f--b" data-reveal>
          <a href={P.mariscos.src.src} data-lightbox data-alt={P.mariscos[lang]}><Photo src={P.mariscos.src} alt={P.mariscos[lang]} sizes="(min-width: 900px) 46vw, 100vw" position="50% 42%" /></a>
          <figcaption><i>4.2</i>{P.mariscos[lang]}</figcaption>
        </figure>
        <figure class="gal__f gal__f--c" data-reveal>
          <a href={IG.mozos.src.src} data-lightbox data-alt={IG.mozos[lang]}><Photo src={IG.mozos.src} alt={IG.mozos[lang]} sizes="(min-width: 900px) 22vw, 50vw" position={IG.mozos.focus} /></a>
          <figcaption><i>4.3</i>{IG.mozos[lang]}</figcaption>
        </figure>
        <div class="gal__ig" data-reveal>
          <p>{s.galleryLead}</p>
          {SOCIAL.instagram && <a class="btn btn--line" href={SOCIAL.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} />{SOCIAL.instagramHandle}</a>}
        </div>
      </div>
    </section>

    <!-- 05 LOCATIONS -->
    <section class="sec" id="locations">
      <div class="g">
        <p class="lab" data-reveal><i>05</i>{s.locationsKicker}</p>
        <h2 class="h2 loc__title" data-reveal>{s.locationsTitle}</h2>
        {LOCATIONS.map((l) => (
          <article class="loc" data-reveal>
            <h3 class="loc__name">{l.name}</h3>
            <div class="loc__info">
              <p class="loc__note">{l.note[lang]}</p>
              <address>{l.street}<br />{l.district}, Lima</address>
              <p class="loc__hours">{l.hours ? l.hours[lang] : s.hoursTbd}</p>
              <div class="loc__btns">
                <a class="btn btn--ink btn--sm" href={whatsappLink(lang, l.id)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{s.reserveHere} {l.name}</a>
                <a class="btn btn--line btn--sm" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener">{s.directions}</a>
                <a class="btn btn--line btn--sm" href={`tel:${PHONE_E164}`}>{s.call}</a>
              </div>
            </div>
            <div class="loc__map">
              <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`${es ? 'Mapa' : 'Map'} — Ceviche House ${l.name}`}>
                <span>{s.loadMap}</span><small>{s.mapPrivacy}</small>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 06 REVIEWS -->
    <section class="sec sec--tight" id="reviews">
      <div class="g">
        <p class="lab" data-reveal><i>06</i>{s.reviewsKicker}</p>
        <div class="rev__head" data-reveal>
          <h2 class="h2 h2--sm">{s.reviewsTitle}</h2>
          <p>{s.reviewsLead}</p>
        </div>
        <ul class="rev" data-reveal>
          {REVIEWS.map((r) => (
            <li><a href={r.url} target="_blank" rel="noopener">
              <span>{s.platform[r.platform]}</span>
              <b>{LOCATIONS.find((l) => l.id === r.location)!.name}</b>
              <em>{r.rating != null ? `${r.rating.toFixed(1)} ${s.ratingOf}` : s.readReviews}</em>
              <Icon name="external" size={16} />
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="g">
      <p class="ft__title">{s.footerReserve}</p>
      <div class="ft__cta">
        <p>{s.footerReserveLead}</p>
        <a class="btn btn--ivory" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      </div>
      <div class="ft__cols">
        {LOCATIONS.map((l) => <div><h3>{l.name}</h3><address>{l.street}<br />{l.district}, Lima</address></div>)}
        <div>
          <h3>{s.follow}</h3>
          <ul>
            <li><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></li>
            {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
            <li><a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a></li>
            <li><a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
        <div>
          <h3>{s.menus}</h3>
          <ul>
            <li><a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a></li>
            <li><a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a></li>
            <li><a href={switchHref} hreflang={other}>{s.switchTo}</a></li>
          </ul>
        </div>
      </div>
      <p class="ft__legal"><span>Ceviche House</span><span>© {new Date().getFullYear()} · {s.rights}</span></p>
    </div>
  </footer>

  <aside aria-label={s.reserveWa}><a class="fab" href={wa} target="_blank" rel="noopener" aria-label={s.reserveWa}><Icon name="whatsapp" size={24} /></a></aside>
</Base>

<style is:global>
  .cC {
    --bg: var(--huarique-blanco); --stone: var(--huarique-acero); --fg: var(--huarique-indigo); --muted: var(--huarique-mut); --line: rgb(23 22 42 / .18);
    --accent: var(--huarique-cobalto);
    --serif: 'Instrument Serif', Georgia, serif; --sans: 'Instrument Sans Variable', system-ui, sans-serif;
    background: var(--bg); color: var(--fg); font: 400 1rem/1.62 var(--sans);
  }
  .cC ::selection { background: var(--huarique-celeste); }
  .cC :focus-visible { outline-color: var(--huarique-cobalto); }
  .cC .g { max-width: var(--max); margin: auto; padding-inline: var(--gut); display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 900px) { .cC .g { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; } }
  .cC .h2 { font: 400 clamp(2.3rem, 5vw, 4.4rem)/1 var(--serif); letter-spacing: -.012em; text-wrap: balance; }
  .cC .h2--sm { font-size: clamp(2rem, 3.6vw, 3rem); }
  .cC i { font-style: normal; font-variant-numeric: tabular-nums; }
  .cC .lab { display: flex; gap: .7rem; font: 500 .82rem/1.3 var(--sans); color: var(--muted); }
  .cC .lab i { color: var(--accent); font-weight: 600; }
  @media (min-width: 900px) { .cC .lab { grid-column: 1 / 4; position: sticky; top: 5.5rem; align-self: start; } }

  .cC .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; padding: .75rem 1.25rem; border-radius: 0; font: 550 .94rem/1 var(--sans); text-decoration: none; border: 1px solid transparent; transition: background var(--dur), color var(--dur), border-color var(--dur); }
  .cC .btn--sm { min-height: 44px; padding: .55rem 1rem; font-size: .88rem; }
  .cC .btn--ink { background: var(--huarique-cobalto); color: var(--huarique-blanco); }
  .cC .btn--ink:hover { background: var(--huarique-cobalto-2); }
  .cC .btn--line { border-color: var(--fg); color: var(--fg); background: transparent; }
  .cC .btn--line:hover { background: var(--fg); color: var(--huarique-blanco); }
  .cC .btn--ivory { background: var(--huarique-blanco); color: var(--huarique-cobalto-2); }
  .cC .btn--ivory:hover { background: #fff; }

  /* Header */
  .cC .hd { position: fixed; inset: 0 0 auto; z-index: 50; transition: background var(--dur), box-shadow var(--dur); }
  .cC .hd[data-scrolled], html[data-nav-open] .cC .hd { background: var(--bg); box-shadow: 0 1px 0 var(--line); }
  .cC .hd__in { max-width: var(--max); margin: auto; padding: .7rem var(--gut); display: flex; align-items: center; gap: 1.5rem; }
  .cC .brand { font: 400 1.5rem/1 var(--serif); text-decoration: none; margin-right: auto; }
  .cC .hd__nav { display: none; gap: 1.6rem; }
  .cC .hd__nav a { font-size: .9rem; text-decoration: none; padding: .6rem 0; display: flex; gap: .35rem; }
  .cC .hd__nav a i { font-size: .72rem; color: var(--accent); }
  .cC .hd__nav a:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .cC .lang { font: 600 .8rem/1 var(--sans); text-decoration: none; padding: .9rem .4rem; color: var(--muted); }
  .cC .hd__cta { display: none; }
  .cC .mbtn { min-height: 44px; padding: 0 .9rem; border: 1px solid var(--fg); background: transparent; font: 550 .88rem/1 var(--sans); }
  .cC .mbtn__c, .cC .mbtn[aria-expanded='true'] .mbtn__o { display: none; }
  .cC .mbtn[aria-expanded='true'] .mbtn__c { display: inline; }
  @media (min-width: 1024px) { .cC .hd__nav, .cC .hd__cta { display: flex; } .cC .mbtn, .cC .dd { display: none !important; } }
  .cC .dd { display: none; padding: .5rem var(--gut) 1.5rem; border-top: 1px solid var(--line); background: var(--bg); }
  .cC .dd[data-open] { display: grid; gap: 1rem; }
  .cC .dd nav { display: grid; }
  .cC .dd nav a { display: flex; align-items: baseline; gap: 1rem; font: 400 2rem/1.25 var(--serif); text-decoration: none; padding: .35rem 0; border-bottom: 1px solid var(--line); }
  .cC .dd nav i { font: 600 .75rem/1 var(--sans); color: var(--accent); }
  .cC .dd__lang { font-weight: 600; padding: .6rem 0; }

  /* Hero */
  .cC .hero { padding: 5.5rem 0 0; }
  .cC .hero__g { row-gap: 1.6rem; }
  .cC .hero__meta { font-size: .82rem; color: var(--muted); }
  .cC .hero__meta--r { display: none; }
  .cC .hero__title { font: 400 clamp(3.2rem, 9.4vw, 8.8rem)/.92 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .cC .hero__title em { color: var(--accent); }
  .cC .hero__lead { color: var(--muted); max-width: 26rem; }
  .cC .hero__cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.6rem; }
  .cC .hero__fig { margin-inline: calc(-1 * var(--gut)); }
  .cC .hero__img { aspect-ratio: 4 / 3; overflow: hidden; }
  @media (min-width: 900px) {
    .cC .hero { padding-top: 7rem; }
    .cC .hero__meta { grid-column: 1 / 7; }
    .cC .hero__meta--r { display: block; grid-column: 7 / 13; text-align: right; }
    .cC .hero__title { grid-column: 1 / 12; border-top: 1px solid var(--line); padding-top: 1.6rem; }
    .cC .hero__side { grid-column: 1 / 5; align-self: end; padding-bottom: .2rem; }
    .cC .hero__fig { grid-column: 5 / 13; margin: 0; }
    .cC .hero__img { aspect-ratio: 16 / 11; }
  }
  .cC .facts { margin-top: clamp(2rem, 4vw, 3.5rem); row-gap: 0; }
  .cC .facts > div { padding: 1.1rem 0 1.3rem; border-top: 1px solid var(--line); }
  .cC .facts dt { font: 400 1.4rem/1.2 var(--serif); display: flex; gap: .6rem; align-items: baseline; }
  .cC .facts dt i { font: 600 .72rem/1 var(--sans); color: var(--accent); }
  .cC .facts dd { margin: .2rem 0 0; font-size: .9rem; color: var(--muted); }
  .cC .facts a { text-underline-offset: 3px; }
  @media (min-width: 600px) and (max-width: 899px) { .cC .facts { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; } }
  @media (min-width: 900px) { .cC .facts > div { grid-column: span 3; } }

  /* Sections */
  .cC .sec { padding: var(--section) 0; }
  .cC .sec--stone { background: var(--stone); }
  .cC .sec--tight { padding-top: 0; }

  .cC .story__main { display: grid; gap: 1.5rem; }
  .cC .story__lede { font: 400 clamp(1.35rem, 2.1vw, 1.7rem)/1.38 var(--serif); }
  .cC .story__cols { display: grid; gap: 1rem; color: var(--muted); }
  .cC .story__fig figcaption, .cC .dishes__fig figcaption, .cC .gal__f figcaption { font-size: .82rem; color: var(--muted); margin-top: .6rem; display: flex; gap: .6rem; }
  .cC .gal__f figcaption i { color: var(--accent); font-weight: 600; }
  .cC .sq { aspect-ratio: 1; overflow: hidden; max-width: 360px; }
  .cC .defs > div { display: grid; gap: .2rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .cC .defs dt { font: italic 400 1.45rem/1.2 var(--serif); }
  .cC .defs dd { margin: 0; color: var(--muted); font-size: .95rem; }
  @media (min-width: 900px) {
    .cC .story__main { grid-column: 4 / 10; }
    .cC .story__cols { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }
    .cC .story__fig { grid-column: 10 / 13; align-self: start; margin-top: .6rem; }
    .cC .defs { grid-column: 4 / 13; display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 1.5rem; margin-top: 2rem; }
  }

  /* Dishes */
  .cC .dishes__head { display: grid; gap: 1rem; }
  .cC .dishes__head p { color: var(--muted); max-width: 26rem; }
  .cC .dishes__img { aspect-ratio: 4 / 5; overflow: hidden; }
  .cC .rows li { display: grid; grid-template-columns: 2.2rem 1fr auto; gap: .2rem 1rem; padding: 1.2rem 0; border-top: 1px solid var(--line); align-items: baseline; }
  .cC .rows li:last-child { border-bottom: 1px solid var(--line); }
  .cC .rows__n { font-size: .75rem; font-weight: 600; color: var(--accent); }
  .cC .rows h3 { font: 400 clamp(1.5rem, 2.4vw, 2rem)/1.1 var(--serif); }
