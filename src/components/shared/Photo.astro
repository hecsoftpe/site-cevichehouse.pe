---
/**
 * Responsive photograph (AVIF/WebP via astro:assets). Real photos only: there is
 * no placeholder state any more. Layouts decide which photos to show.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  position?: string;
}
const { src, alt, sizes = '100vw', eager = false, class: cls, position = 'center' } = Astro.props;
// Never request more pixels than the original has.
const widths = (Astro.props.widths ?? [400, 640, 860, 1080]).filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 1200) widths.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  quality={78}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={cls}
  style={`object-position:${position}`}
/>
