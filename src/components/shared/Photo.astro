---
/**
 * Renders an authentic photo (responsive, AVIF/WebP via astro:assets) or a
 * branded placeholder when the asset does not exist yet.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fish from './Fish.astro';

interface Props {
  src: ImageMetadata | null;
  alt: string;
  label?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  tone?: 'light' | 'dark' | 'accent';
  position?: string;
}
const { src, alt, label, sizes = '100vw', widths = [480, 800, 1080], eager = false, class: cls, tone = 'light', position = 'center' } = Astro.props;
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={cls}
    style={`object-position:${position}`}
  />
) : (
  <div class:list={['ph', `ph--${tone}`, cls]} role="img" aria-label={alt}>
    <Fish class="ph__fish" size={72} />
    {label && <span class="ph__label">{label}</span>}
    <span class="ph__name">{alt}</span>
  </div>
)}
<style>
  .ph {
    display: grid; place-content: center; justify-items: center; gap: .5rem;
    width: 100%; height: 100%; min-height: 12rem; text-align: center; padding: 1.5rem;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, currentColor 5%, transparent) 14px 15px),
      var(--ph-bg);
    color: var(--ph-fg);
  }
  .ph--light { --ph-bg: #e9e4da; --ph-fg: #1d5f93; }
  .ph--dark { --ph-bg: #13263b; --ph-fg: #9fc6e6; }
  .ph--accent { --ph-bg: #1482c5; --ph-fg: #f4f1ea; }
  .ph__fish { opacity: .85; }
  .ph__label { font: 600 .7rem/1 system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; opacity: .8; }
  .ph__name { font: 400 .85rem/1.3 system-ui, sans-serif; opacity: .9; max-width: 22ch; }
</style>
