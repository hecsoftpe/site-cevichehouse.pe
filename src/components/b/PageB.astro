---
/**
 * Concept B — Lima Vibrant ("Barrio").
 * The energy of a Lima barrio cevichería, said once and loudly instead of
 * everywhere: condensed grotesque headlines, ink + camote, one ticker, one
 * stamp, photos cut large. Bricolage Grotesque (condensed) + Instrument Sans.
 */
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../../styles/tokens.css';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Photo from '../shared/Photo.astro';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { P, GALLERY } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const nav = [
  ['#story', s.nav.story], ['#dishes', s.nav.menu], ['#gallery', s.nav.gallery],
  ['#locations', s.nav.locations], ['#reviews', s.nav.reviews],
] as const;
const name = (o: { es: string; en: string }) => o[lang];
const ticker = es
  ? ['Ceviche al momento', 'Leche de tigre', 'Pesca del día', 'Jalea mixta', 'Pisco sour', 'Miraflores', 'Barranco']
  : ['Ceviche made to order', "Tiger's milk", 'Catch of the day', 'Jalea mixta', 'Pisco sour', 'Miraflores', 'Barranco'];
const stamp = 'Miraflores · Barranco · Lima · ';
---
<Base lang={lang} path={path} bodyClass="cB" indexable={indexable} canonicalPath={canonicalPath} themeColor="#0f1e26">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <div class="hd__bar">
      <a class="brand" href="#top" aria-label="Ceviche House">Ceviche<span>House</span></a>
      <nav class="hd__nav" aria-label={es ? 'Principal' : 'Main'}>
        {nav.map(([h, l]) => <a href={h}>{l}</a>)}
      </nav>
      <a class="lang" href={switchHref} hreflang={other} aria-label={s.switchLabel}>{other.toUpperCase()}</a>
      <a class="btn btn--camote hd__cta" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserve}</a>
      <button class="menuBtn" type="button" data-nav-toggle aria-controls="b-sheet" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </header>

  <div class="sheet" id="b-sheet">
    <div class="sheet__scrim" data-nav-close></div>
    <div class="sheet__panel" role="dialog" aria-modal="true" aria-label={s.openMenu}>
      <nav class="sheet__nav" aria-label={es ? 'Móvil' : 'Mobile'}>
        {nav.map(([h, l]) => <a href={h}>{l}</a>)}
      </nav>
      <div class="sheet__row">
        <a class="btn btn--camote" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />{s.reserveWa}</a>
        <a class="btn btn--ghost" href={switchHref} hreflang={other}>{s.switchTo}</a>
        <button class="btn btn--ghost" type="button" data-nav-close><Icon name="close" size={18} />{s.closeMenu}</button>
      </div>
    </div>
  </div>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero__in">
        <div class="hero__copy">
          <p class="hero__k">{s.eyebrow}</p>
          <h1 class="hero__title">{es
            ? <Fragment>Ceviche al momento. <span>Sabor de Lima.</span></Fragment>
            : <Fragment>Ceviche, made to order. <span>Tasting of Lima.</span></Fragment>}</h1>
          <p class="hero__lead">{s.heroLead}</p>
          <div class="hero__cta">
            <a class="btn btn--camote btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} />{s.reserveLong}</a>
            <a class="btn btn--ghost btn--lg" href="#menu">{s.exploreMenu}<Icon name="arrow" size={20} /></a>
          </div>
        </div>
        <div class="hero__art">
          <div class="hero__main"><Photo src={P.ceviche.src} alt={P.ceviche[lang]} eager sizes="(min-width: 1024px) 46vw, 100vw" position={P.ceviche.focus} /></div>
          <div class="hero__inset"><Photo src={P.mariscosDetalle.src} alt={P.mariscosDetalle[lang]} sizes="(min-width: 1024px) 220px, 34vw" /></div>
          <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="b-ring" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
            <text><textPath href="#b-ring" textLength="286" lengthAdjust="spacing">{stamp}</textPath></text>
          </svg>
        </div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => <span>{ticker.map((w) => <Fragment><b>{w}</b><i>/</i></Fragment>)}</span>)}
      </div>
    </div>

    <!-- STORY -->
    <section class="story" id="story">
      <div class="wrap">
        <p class="k" data-reveal>{s.storyKicker}</p>
        <h2 class="h2 story__title" data-reveal>{s.storyTitle}</h2>
        <div class="story__cols" data-reveal>
          <p class="story__lede">{s.storyP1}</p>
          <div class="story__body"><p>{s.storyP2}</p><p>{s.storyP3}</p></div>
        </div>
        <ol class="nums">
          {s.pillars.map((p, i) => (
            <li data-reveal><span class="nums__n">0{i + 1}</span><h3>{p.t}</h3><p>{p.d}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SIGNATURE DISHES: rail -->
    <section class="dishes" id="dishes">
      <div class="wrap dishes__head">
        <div>
          <p class="k k--light" data-reveal>{s.dishesKicker}</p>
          <h2 class="h2" data-reveal>{s.dishesTitle}</h2>
        </div>
        <p data-reveal>{s.dishesLead}</p>
      </div>
      <ol class="rail" tabindex="0" aria-label={s.dishesTitle}>
        <li class="dcard dcard--photo">
          <Photo src={P.mariscos.src} alt={P.mariscos[lang]} sizes="(min-width: 900px) 360px, 80vw" position={P.mariscos.focus} />
          <span class="dcard__cap" aria-hidden="true">{P.mariscos[lang]}</span>
        </li>
        {dishes.map((d, i) => (
          <li class="dcard">
            <span class="dcard__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="dcard__cat">{d.category}</span>
            <h3 class="dcard__name">{d.name}</h3>
            <p class="dcard__desc">{d.desc}</p>
            <span class="dcard__price">{d.price}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- FULL MENU -->
    <section class="menu" id="menu" data-menu data-menu-default="ceviches">
      <div class="wrap">
        <div class="menu__head">
          <div>
            <p class="k" data-reveal>{s.fullMenuKicker}</p>
            <h2 class="h2" data-reveal>{s.fullMenuTitle}</h2>
          </div>
          <p class="menu__pdf">
            <a href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={18} />{s.menuPdf}</a>
            <a href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={18} />{s.menuPdfOther}</a>
          </p>
        </div>
        <div class="tabs" role="group" aria-label={s.fullMenuTitle}>
          <button type="button" data-filter="all" aria-pressed="true">{s.allCats}</button>
          {MENU.map((c) => <button type="button" data-filter={c.id} aria-pressed="false">{name(c)}</button>)}
        </div>
        <div class="menu__grid">
          {MENU.map((c) => (
            <section class="mcat" data-cat={c.id} aria-labelledby={`b-cat-${c.id}`}>
              <h3 id={`b-cat-${c.id}`}>{name(c)}</h3>
              <ul>
                {c.items.map((it) => (
                  <li>
                    <span>{name(it)}{(es ? it.subEs : it.subEn) && <small>{es ? it.subEs : it.subEn}</small>}</span>
                    <b>{priceOf(it, lang)}</b>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="menu__note">{s.menuNote}</p>
      </div>
    </section>

    <!-- GALLERY: film strip -->
    <section class="gal" id="gallery">
      <div class="wrap gal__head">
        <div>
          <p class="k k--light" data-reveal>{s.galleryKicker}</p>
          <h2 class="h2" data-reveal>{s.galleryTitle}</h2>
        </div>
        <p data-reveal>{s.galleryLead}</p>
      </div>
      <ul class="strip">
        {GALLERY.map((g, i) => (
          <li class={`strip__it strip__it--${i}`}>
            <a href={g.src.src} data-lightbox data-alt={g[lang]}>
              <Photo src={g.src} alt={g[lang]} sizes={g.detail ? '(min-width: 900px) 22vw, 60vw' : '(min-width: 900px) 34vw, 80vw'} position={g.focus} />
            </a>
          </li>
        ))}
      </ul>
      {SOCIAL.instagram && (
        <div class="wrap">
          <a class="ig" href={SOCIAL.instagram} target="_blank" rel="noopener">
            <span class="ig__k">{s.igCta}</span>
            <span class="ig__h">{SOCIAL.instagramHandle}</span>
            <Icon name="arrow" size={36} />
          </a>
        </div>
      )}
    </section>

    <!-- LOCATIONS -->
    <section class="loc" id="locations">
      <div class="wrap">
        <p class="k" data-reveal>{s.locationsKicker}</p>
        <h2 class="h2" data-reveal>{s.locationsTitle}</h2>
        <div class="loc__grid">
          {LOCATIONS.map((l, i) => (
            <article class={`lcard lcard--${i}`} data-reveal>
              <h3 class="lcard__name">{l.name}</h3>
              <p class="lcard__note">{l.note[lang]}</p>
              <address>{l.street} · {l.district}, Lima</address>
              <p class="lcard__hours">{l.hours ? l.hours[lang] : s.hoursTbd}</p>
              <div class="lcard__btns">
                <a class="btn btn--ink" href={whatsappLink(lang, l.id)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveHere} {l.name}</a>
                <a class="btn btn--line" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener"><Icon name="pin" size={18} />{s.directions}</a>
                <a class="btn btn--line" href={`tel:${PHONE_E164}`}><Icon name="phone" size={18} />{s.call}</a>
              </div>
              <div class="lcard__map">
                <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`${es ? 'Mapa' : 'Map'} — Ceviche House ${l.name}`}>
                  <b>{s.loadMap}</b><small>{s.mapPrivacy}</small>
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section class="rev" id="reviews">
      <div class="wrap rev__in">
        <div>
          <p class="k" data-reveal>{s.reviewsKicker}</p>
          <h2 class="h2 h2--sm" data-reveal>{s.reviewsTitle}</h2>
          <p class="rev__lead" data-reveal>{s.reviewsLead}</p>
        </div>
        <ul class="rev__links" data-reveal>
          {REVIEWS.map((r) => (
            <li><a href={r.url} target="_blank" rel="noopener">
              <span>{s.platform[r.platform]}</span><b>{LOCATIONS.find((l) => l.id === r.location)!.name}</b>
              {r.rating != null && <em>{r.rating.toFixed(1)}/5</em>}
              <Icon name="external" size={18} />
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="wrap">
      <a class="ft__big" href={wa} target="_blank" rel="noopener">{s.footerReserve}<Icon name="arrow" size={48} /></a>
      <p class="ft__lead">{s.footerReserveLead}</p>
      <div class="ft__grid">
        <div><p class="brand">Ceviche<span>House</span></p><p class="ft__tag">{s.footerTag}</p></div>
        {LOCATIONS.map((l) => <div><h3>{l.name}</h3><address>{l.street}<br />{l.district}, Lima</address></div>)}
        <div>
          <h3>{s.follow}</h3>
          <ul>
            <li><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></li>
            {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
            <li><a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a></li>
            <li><a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
        <div>
          <h3>{s.menus}</h3>
          <ul>
            <li><a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a></li>
            <li><a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a></li>
            <li><a href={switchHref} hreflang={other}>{s.switchTo}</a></li>
          </ul>
        </div>
      </div>
      <p class="ft__legal">© {new Date().getFullYear()} Ceviche House · Lima, Perú. {s.rights}</p>
    </div>
  </footer>

  <aside class="bar" aria-label={s.reserveWa}>
    <a class="btn btn--camote" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />{s.reserve}</a>
    <a class="btn btn--ghost" href="#menu">{s.nav.menu}</a>
  </aside>
</Base>

<style is:global>
  .cB {
    --bg: var(--ivory-100); --fg: var(--ink-900); --muted: #57564f; --line: rgb(15 30 38 / .18);
    --dark: var(--ink-900); --on-dark: var(--ivory-50); --on-dark-mut: rgb(247 243 236 / .7); --line-dark: rgb(247 243 236 / .16);
    --hot: var(--camote-400); --hot-ink: var(--aji-700);
    --disp: 'Bricolage Grotesque Variable', 'Arial Narrow', sans-serif; --sans: 'Instrument Sans Variable', system-ui, sans-serif;
    background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.6 var(--sans);
  }
  .cB ::selection { background: var(--hot); color: var(--ink-900); }
  .cB :focus-visible { outline-color: var(--hot); }
  .cB .wrap { max-width: var(--max); margin: auto; padding-inline: var(--gut); }
  .cB .h2 { font: 700 clamp(2.4rem, 6vw, 5rem)/.95 var(--disp); font-stretch: 75%; letter-spacing: -.01em; text-wrap: balance; }
  .cB .h2--sm { font-size: clamp(2rem, 4vw, 3.2rem); }
  .cB .k { font: 600 .85rem/1 var(--sans); color: var(--hot-ink); margin-bottom: 1rem; }
  .cB .k--light { color: var(--hot); }

  .cB .btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 48px; padding: .75rem 1.3rem; border-radius: 4px; font: 650 .98rem/1 var(--sans); text-decoration: none; border: 1.5px solid transparent; transition: background var(--dur), color var(--dur), border-color var(--dur), transform var(--dur) var(--ease); }
  .cB .btn:active { transform: translateY(1px); }
  .cB .btn--lg { min-height: 56px; padding: 1rem 1.6rem; font-size: 1.05rem; }
  .cB .btn--camote { background: var(--hot); color: var(--ink-950); }
  .cB .btn--camote:hover { background: #f0a965; }
  .cB .btn--ghost { border-color: var(--line-dark); color: var(--on-dark); background: transparent; }
  .cB .btn--ghost:hover { border-color: var(--on-dark); }
  .cB .btn--ink { background: var(--ink-900); color: var(--ivory-50); }
  .cB .btn--ink:hover { background: var(--ink-700); }
  .cB .btn--line { border-color: var(--line); color: var(--fg); }
  .cB .btn--line:hover { border-color: var(--fg); }

  /* Header */
  .cB .hd { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--on-dark); transition: background var(--dur); }
  .cB .hd[data-scrolled] { background: var(--ink-900); box-shadow: 0 1px 0 var(--line-dark); }
  .cB .hd__bar { max-width: var(--max); margin: auto; padding: .7rem var(--gut); display: flex; align-items: center; gap: 1rem; }
  .cB .brand { font: 800 1.45rem/1 var(--disp); font-stretch: 75%; text-decoration: none; letter-spacing: -.01em; display: inline-flex; gap: .25em; margin-right: auto; }
  .cB .brand span { color: var(--hot); }
  .cB .hd__nav { display: none; gap: 1.6rem; margin-right: 1rem; }
  .cB .hd__nav a { text-decoration: none; font-weight: 550; font-size: .95rem; padding: .6rem 0; color: var(--on-dark-mut); transition: color var(--dur); }
  .cB .hd__nav a:hover { color: var(--on-dark); }
  .cB .lang { font: 650 .85rem/1 var(--sans); text-decoration: none; padding: .9rem .6rem; color: var(--on-dark-mut); }
  .cB .hd__cta { display: none; min-height: 44px; }
  .cB .menuBtn { width: 46px; height: 46px; display: grid; place-content: center; border: 1.5px solid var(--line-dark); border-radius: 4px; background: transparent; color: var(--on-dark); }
  @media (min-width: 1024px) { .cB .hd__nav, .cB .hd__cta { display: flex; } .cB .menuBtn { display: none; } }

  .cB .sheet { position: fixed; inset: 0; z-index: 80; visibility: hidden; }
  .cB .sheet[data-open] { visibility: visible; }
  .cB .sheet__scrim { position: absolute; inset: 0; background: rgb(11 22 28 / .6); opacity: 0; transition: opacity .3s; }
  .cB .sheet[data-open] .sheet__scrim { opacity: 1; }
  .cB .sheet__panel { position: absolute; inset: auto 0 0; background: var(--ink-900); color: var(--on-dark); padding: 1.5rem var(--gut) calc(1.5rem + env(safe-area-inset-bottom)); transform: translateY(100%); transition: transform .4s var(--ease); border-top: 3px solid var(--hot); }
  .cB .sheet[data-open] .sheet__panel { transform: none; }
  .cB .sheet__nav { display: grid; margin-bottom: 1.5rem; }
  .cB .sheet__nav a { font: 700 2.4rem/1.15 var(--disp); font-stretch: 75%; text-decoration: none; padding: .3rem 0; border-bottom: 1px solid var(--line-dark); }
  .cB .sheet__row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .cB .sheet__row .btn:first-child { flex: 1 1 100%; }

  /* Hero */
  .cB .hero { background: var(--dark); color: var(--on-dark); padding: 5.5rem 0 clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .cB .hero__in { max-width: var(--max); margin: auto; padding-inline: var(--gut); display: grid; gap: 2.5rem; }
  .cB .hero__k { font: 550 .9rem/1.4 var(--sans); color: var(--on-dark-mut); }
  .cB .hero__title { font: 800 clamp(3.4rem, 10.5vw, 9.2rem)/.86 var(--disp); font-stretch: 75%; letter-spacing: -.02em; margin: 1rem 0 1.5rem; text-wrap: balance; }
  .cB .hero__title span { display: block; color: var(--hot); }
  .cB .hero__lead { max-width: 30rem; color: var(--on-dark-mut); font-size: 1.1rem; }
  .cB .hero__cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .cB .hero__art { position: relative; margin-inline: calc(-1 * var(--gut)); }
  .cB .hero__main { aspect-ratio: 1; overflow: hidden; }
  .cB .hero__inset { position: absolute; left: var(--gut); bottom: -1.5rem; width: 34%; max-width: 220px; aspect-ratio: 1; overflow: hidden; border: 4px solid var(--dark); }
  .cB .stamp { position: absolute; right: var(--gut); top: -2.2rem; width: 120px; height: 120px; font: 700 10.5px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; fill: var(--hot); background: var(--dark); border-radius: 50%; }
  @media (prefers-reduced-motion: no-preference) { .cB .stamp text { animation: bSpin 40s linear infinite; transform-origin: 60px 60px; } }
  @keyframes bSpin { to { transform: rotate(360deg); } }
  @media (min-width: 1024px) {
    .cB .hero { min-height: 100svh; display: grid; align-items: center; padding-top: 6rem; }
    .cB .hero__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: 0; }
    .cB .hero__copy { position: relative; z-index: 2; padding-right: 2rem; }
    .cB .hero__title { font-size: clamp(5rem, 8.6vw, 9.2rem); margin-right: -14%; }
    .cB .hero__art { margin: 0; }
    .cB .hero__main { aspect-ratio: 4 / 5; }
    .cB .hero__inset { left: -3.5rem; bottom: 2.5rem; width: 210px; border-width: 6px; }
    .cB .stamp { right: -1.5rem; top: -2.5rem; width: 132px; height: 132px; }
  }

  .cB .ticker { background: var(--hot); color: var(--ink-950); overflow: hidden; border-block: 1px solid var(--ink-900); }
  .cB .ticker__track { display: flex; width: max-content; }
  .cB .ticker__track > span { display: flex; align-items: center; gap: 1.6rem; padding: .8rem .8rem; font: 700 clamp(1.3rem, 2.4vw, 1.9rem)/1 var(--disp); font-stretch: 75%; white-space: nowrap; }
  .cB .ticker i { font-style: normal; opacity: .45; }
  @media (prefers-reduced-motion: no-preference) { .cB .ticker__track { animation: bTick 55s linear infinite; } }
  @keyframes bTick { to { transform: translateX(-50%); } }

  /* Story */
  .cB .story { padding: var(--section) 0; }
  .cB .story__title { max-width: 15ch; }
  .cB .story__cols { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  .cB .story__lede { font-size: clamp(1.2rem, 1.9vw, 1.45rem); line-height: 1.5; font-weight: 450; max-width: 36rem; }
  .cB .story__body { display: grid; gap: 1rem; color: var(--muted); max-width: 34rem; }
  .cB .nums { display: grid; gap: 0; margin-top: clamp(3rem, 6vw, 5rem); border-top: 2px solid var(--fg); }
  .cB .nums li { display: grid; grid-template-columns: 4.2rem 1fr; gap: .2rem 1rem; padding: 1.3rem 0; border-bottom: 1px solid var(--line); }
  .cB .nums__n { grid-row: span 2; font: 800 2.6rem/1 var(--disp); font-stretch: 75%; color: var(--hot-ink); }
  .cB .nums h3 { font: 700 1.6rem/1.1 var(--disp); font-stretch: 75%; }
