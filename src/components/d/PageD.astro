  @media (min-width: 900px) { .cD .sheet__head { grid-column: 1 / 13; grid-template-columns: 1fr 1fr; align-items: end; } .cD .sheet__head .k { grid-column: 1 / -1; } .cD .sheet__grid { grid-column: 1 / 13; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem 1rem; padding: 1.6rem 1.2rem; } }
