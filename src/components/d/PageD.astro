  .cD .carta__tabs { display: flex; gap: .3rem; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gut)); padding: .6rem var(--gut); position: sticky; top: 5.6rem; z-index: 3; background: var(--parte-choclo); border-block: 2px solid var(--fg); }
  .cD .carta__tabs button { flex: none; display: flex; align-items: baseline; gap: .4rem; min-height: 44px; padding: .5rem .75rem; border: 2px solid transparent; background: none; font: 500 .8rem/1.15 var(--mono); text-transform: uppercase; text-align: left; color: var(--parte-mandil); }
