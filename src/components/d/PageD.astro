  .cD .lot { position: relative; display: flex; flex-direction: column; gap: .55rem; padding: 1.1rem 1.1rem 1rem; border-bottom: 2px solid var(--fg); border-right: 2px solid var(--fg); min-height: 15rem; transition: background var(--dur); }
