---
/**
 * Concept D — PARTE DE MAR.
 * The house's daily sheet: what came in from the sea and went out to the
 * table. Identity from the paperwork of fresh fish (lot labels, stencil
 * stamps, tallies, technical callouts, contact sheets) set in Big Shoulders,
 * Source Sans 3 and IBM Plex Mono, in flat colours sampled from the
 * restaurant's own photos. See docs/PARTE-DE-MAR.md.
 */
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource-variable/big-shoulders-stencil-display/wght';
import '@fontsource-variable/source-sans-3/wght';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../../styles/tokens.css';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Photo from '../shared/Photo.astro';
import Stamp from './Stamp.astro';
import Lot from './Lot.astro';
import Annotated from './Annotated.astro';
import { COPY } from './copy';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { P, IG } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const c = COPY[lang];
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const name = (o: { es: string; en: string }) => o[lang];
const nn = (i: number) => String(i).padStart(2, '0');
const nav = [
  ['cocina', c.nav.cocina], ['lotes', c.nav.lotes], ['carta', c.nav.carta],
  ['casas', c.nav.casas], ['sala', c.nav.sala], ['reserva', c.nav.reserva],
] as const;
const mira = LOCATIONS[0], barr = LOCATIONS[1];
const sheet = [IG.ceviche, IG.mozos, IG.casona, P.mariscos, IG.terraza, P.ceviche, IG.review, IG.huarique, P.mariscosDetalle, P.cevicheDetalle];
const marked = new Set([0, 4]);
const sigPrice = dishes[0].price;
---
<Base lang={lang} path={path} bodyClass="cD" indexable={indexable} canonicalPath={canonicalPath} themeColor="#f7f6f2">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <p class="strip">
      <span data-parte-date data-lang={lang}>{c.parte} · {c.city}</span>
      <span class="strip__r">{mira.house[lang]} · {barr.house[lang]}</span>
    </p>
    <div class="bar">
      <a class="brand" href="#top" aria-label="Ceviche House">Ceviche&nbsp;House</a>
      <nav class="nav" aria-label={es ? 'Principal' : 'Main'}>
        {nav.map(([id, l], i) => <a href={`#${id}`} data-spy={id}><i>{nn(i + 1)}</i>{l}</a>)}
      </nav>
      <a class="lang" href={switchHref} hreflang={other} aria-label={s.switchLabel}>{other.toUpperCase()}</a>
      <a class="btn btn--choclo bar__cta" href={wa} target="_blank" rel="noopener">{c.reserve}</a>
      <button class="mbtn" type="button" data-nav-toggle aria-controls="d-menu" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
        <span class="mbtn__o">{c.menu}</span><span class="mbtn__c">{c.close}</span>
      </button>
    </div>
  </header>

  <div class="ov" id="d-menu">
    <nav aria-label={es ? 'Móvil' : 'Mobile'}>
      {nav.map(([id, l], i) => <a href={`#${id}`}><i>{nn(i + 1)}</i>{l}</a>)}
    </nav>
    <div class="ov__foot">
      <a class="btn btn--choclo" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      <a class="ov__lang" href={switchHref} hreflang={other}>{s.switchTo}</a>
    </div>
  </div>

  <main id="main">
    <!-- 01 · HERO -->
    <section class="hero" id="top">
      <div class="hero__copy">
        <h1 class="hero__title">
          <span class="sr-only">Ceviche House — </span>
          {c.hero.map((w, i) => <span class={`hero__w hero__w--${i}`}>{w}{' '}</span>)}
        </h1>
        <div class="hero__meta">
          <p class="hero__lead">{c.heroLead}</p>
          <div class="hero__cta">
            <a class="btn btn--mandil" href="#carta">{c.heroCta}<Icon name="arrow" size={18} /></a>
            <a class="btn btn--line" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{c.reserve}</a>
          </div>
          <dl class="ticket">
            <div><dt>{dishes[0].name}</dt><dd>{sigPrice}</dd></div>
            {LOCATIONS.map((l) => <div><dt>{l.house[lang]}</dt><dd>{l.street}</dd></div>)}
          </dl>
        </div>
      </div>
      <figure class="hero__fig">
        <div class="hero__img"><Photo src={IG.ceviche.src} alt={IG.ceviche[lang]} eager sizes="(min-width: 1024px) 44vw, 100vw" position={IG.ceviche.focus} /></div>
        <Stamp lines={c.stamp} class="hero__stamp" />
        <figcaption><b>{c.fig}</b> {IG.ceviche[lang]}. <span>{SOCIAL.instagramHandle}</span></figcaption>
      </figure>
    </section>

    <!-- 02 · COCINA -->
    <section class="cocina" id="cocina" data-spy-target>
      <div class="g">
        <p class="k k--light" data-reveal>{c.cocinaK}</p>
        <h2 class="cocina__title" data-reveal>{c.cocina.map((l, i) => <span class={`cocina__l cocina__l--${i}`}>{l}{' '}</span>)}</h2>
        <p class="cocina__src" data-reveal>— {c.cocinaSrc}</p>
        <div class="cocina__body" data-reveal>
          <p>{s.storyP1}</p>
          <p>{s.storyP2}</p>
        </div>
        <ol class="tally" data-reveal>
          {s.pillars.map((p, i) => <li><span>{nn(i + 1)}</span><b>{p.t}</b><p>{p.d}</p></li>)}
        </ol>
      </div>
    </section>

    <!-- 03 · LOTES DEL DÍA -->
    <section class="lotes" id="lotes" data-spy-target>
      <div class="g">
        <header class="lotes__head" data-reveal>
          <p class="k">{c.lotesK}</p>
          <h2 class="h2">{c.lotesTitle}</h2>
          <p class="lotes__lead">{c.lotesLead}</p>
        </header>
        <div class="lotes__ann" data-reveal>
          <Annotated
            src={P.ceviche.src}
            alt={P.ceviche[lang]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            title={c.annotTitle}
            note={c.annotNote}
            points={[
              { x: 30, y: 42, label: c.annot.camote, side: 'l' },
              { x: 58, y: 47, label: c.annot.palta, side: 'l' },
              { x: 62.5, y: 36.5, label: c.annot.alcaparras },
              { x: 74, y: 44.5, label: c.annot.rocoto },
              { x: 95.5, y: 76, label: c.annot.choclo, side: 'l' },
            ]}
          />
        </div>
        <ol class="lotes__list">
          {dishes.map((d, i) => (
            <Lot n={i + 1} lotLabel={c.lot} category={d.category} name={d.name} desc={d.desc} price={d.price}
              tone={i === 0 ? 'choclo' : i === 6 ? 'mandil' : 'plain'} wide={i === 0 || i === 6 || i === 8} />
          ))}
        </ol>
      </div>
    </section>

    <!-- 04 · CARTA -->
    <section class="carta" id="carta" data-spy-target data-menu data-menu-default="ceviches">
      <div class="g">
        <header class="carta__head">
          <p class="k">{c.cartaK}</p>
          <h2 class="carta__title">{c.cartaTitle}</h2>
          <p class="carta__pdf">
            <a href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={16} />{s.menuPdf}</a>
            <a href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={16} />{s.menuPdfOther}</a>
          </p>
        </header>
        <div class="carta__idx">
          <p class="carta__idxK">{c.index}</p>
          <div class="carta__tabs" role="group" aria-label={s.fullMenuTitle}>
            <button type="button" data-filter="all" aria-pressed="true"><i>00</i>{s.allCats}</button>
            {MENU.map((cat, i) => <button type="button" data-filter={cat.id} aria-pressed="false"><i>{nn(i + 1)}</i>{name(cat)}<em>{cat.items.length}</em></button>)}
          </div>
        </div>
        <div class="carta__cols">
          {MENU.map((cat, i) => (
            <section class="mcat" data-cat={cat.id} aria-labelledby={`d-cat-${cat.id}`}>
              <h3 id={`d-cat-${cat.id}`}><i>{nn(i + 1)}</i>{name(cat)}</h3>
              <ul>
                {cat.items.map((it) => (
                  <li>
                    <span class="mcat__n">{name(it)}{(es ? it.subEs : it.subEn) && <small>{es ? it.subEs : it.subEn}</small>}</span>
                    <span class="mcat__d" aria-hidden="true"></span>
                    <span class="mcat__p">{priceOf(it, lang)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <p class="carta__note">{s.menuNote}</p>
        </div>
      </div>
    </section>

    <!-- 05 · CASAS -->
    <section class="casas" id="casas" data-spy-target>
      <div class="g">
        <header class="casas__head" data-reveal>
          <p class="k">{c.casasK}</p>
          <h2 class="h2">{c.casasTitle}</h2>
        </header>
        <article class="casa casa--1">
          <figure class="casa__fig casa__fig--wide" data-reveal>
            <Photo src={IG.huarique.src} alt={IG.huarique[lang]} sizes="(min-width: 900px) 62vw, 100vw" position={IG.huarique.focus} />
          </figure>
          <div class="casa__txt" data-reveal>
            <p class="casa__no">{c.casa} 01 · {mira.district}</p>
            <h3 class="casa__name">{mira.house[lang]}</h3>
            <p>{mira.note[lang]}</p>
            <p class="casa__addr">{mira.street}</p>
          </div>
        </article>
        <article class="casa casa--2">
          <div class="casa__txt" data-reveal>
            <p class="casa__no">{c.casa} 02 · {barr.district}</p>
            <h3 class="casa__name">{barr.house[lang]}</h3>
            <p>{barr.note[lang]}</p>
            <p class="casa__addr">{barr.street}</p>
          </div>
          <figure class="casa__fig casa__fig--tall" data-reveal>
            <Photo src={IG.casona.src} alt={IG.casona[lang]} sizes="(min-width: 900px) 40vw, 100vw" position={IG.casona.focus} />
          </figure>
          <figure class="casa__fig casa__fig--small" data-reveal>
            <Photo src={IG.terraza.src} alt={IG.terraza[lang]} sizes="(min-width: 900px) 22vw, 60vw" position={IG.terraza.focus} />
          </figure>
        </article>
      </div>
    </section>

    <!-- 06 · HOJA DE CONTACTOS -->
    <section class="sheet" id="galeria">
      <div class="g">
        <header class="sheet__head" data-reveal>
          <p class="k k--light">{c.galK}</p>
          <h2 class="h2">{c.galTitle}</h2>
          <p class="sheet__lead">{c.galLead}</p>
        </header>
        <ul class="sheet__grid">
          {sheet.map((g, i) => (
            <li class:list={['frame', { 'frame--mark': marked.has(i) }]} data-reveal>
              <a href={g.src.src} data-lightbox data-alt={g[lang]}>
                <Photo src={g.src} alt={g[lang]} sizes="(min-width: 900px) 18vw, 45vw" position={g.focus} widths={[300, 460, 640]} />
              </a>
              <span class="frame__no" aria-hidden="true">{nn(i + 1)}A ▸</span>
            </li>
          ))}
        </ul>
        {SOCIAL.instagram && (
          <a class="sheet__ig" href={SOCIAL.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={20} />{SOCIAL.instagramHandle}<Icon name="arrow" size={20} /></a>
        )}
      </div>
    </section>

    <!-- 07 · LA SALA -->
    <section class="sala" id="sala" data-spy-target>
      <div class="g">
        <figure class="sala__fig" data-reveal>
          <Photo src={IG.mozos.src} alt={IG.mozos[lang]} sizes="(min-width: 900px) 50vw, 100vw" position={IG.mozos.focus} />
        </figure>
        <div class="sala__txt" data-reveal>
          <p class="k">{c.salaK}</p>
          <h2 class="h2">{c.salaTitle}</h2>
          <p class="sala__p">{s.storyP3}</p>
          <blockquote class="sala__q">
            <p>{c.salaQuote}</p>
            <footer>{c.salaQuoteSrc}</footer>
          </blockquote>
          <p class="pending" role="note">{c.pending}</p>
          <div class="sala__rev">
            <p>{c.reviewsK}</p>
            <ul>
              {REVIEWS.map((r) => (
                <li><a href={r.url} target="_blank" rel="noopener">{s.platform[r.platform]} · {LOCATIONS.find((l) => l.id === r.location)!.name}<Icon name="external" size={14} /></a></li>
              ))}
            </ul>
          </div>
        </div>
        <figure class="sala__mini" data-reveal>
          <Photo src={IG.review.src} alt={IG.review[lang]} sizes="(min-width: 900px) 16vw, 40vw" position={IG.review.focus} />
        </figure>
      </div>
    </section>

    <!-- 08 · UBICACIÓN Y CONTACTO -->
    <section class="dest" id="contacto">
      <div class="g">
        {LOCATIONS.map((l, i) => (
          <article class="label" data-reveal>
            <header class="label__top"><span>{c.casa} {nn(i + 1)}</span><span>{l.district} · Lima</span></header>
            <h3 class="label__name">{l.house[lang]}</h3>
            <dl class="label__rows">
              <div><dt>{c.casasDetail}</dt><dd>{l.street}</dd></div>
              <div><dt>{c.district}</dt><dd>{l.district}, Lima</dd></div>
              <div><dt>{c.hours}</dt><dd>{l.hours ? l.hours[lang] : s.hoursAsk}</dd></div>
              <div><dt>{c.phone}</dt><dd><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></dd></div>
            </dl>
            <div class="label__btns">
              <a class="btn btn--mandil btn--sm" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener"><Icon name="pin" size={16} />{s.directions}</a>
              <a class="btn btn--line btn--sm" href={`tel:${PHONE_E164}`}><Icon name="phone" size={16} />{s.call}</a>
            </div>
            <div class="label__map">
              <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`${es ? 'Mapa' : 'Map'} — Ceviche House ${l.name}`}>
                <span>{s.loadMap}</span><small>{s.mapPrivacy}</small>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 09 · RESERVAS -->
    <section class="reserva" id="reserva" data-spy-target>
      <div class="g">
        <p class="k k--mandil">{c.reservaK}</p>
        <h2 class="reserva__title">{c.reservaTitle}</h2>
        <p class="reserva__lead">{c.reservaLead}</p>
        <ul class="reserva__go">
          {LOCATIONS.map((l) => (
            <li><a href={whatsappLink(lang, l.id)} target="_blank" rel="noopener">
              <span>{c.reservaIn}</span><b>{l.house[lang]}</b><Icon name="arrow" size={40} />
            </a></li>
          ))}
        </ul>
        <p class="reserva__tel">WhatsApp · <a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></p>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="g">
      <p class="ft__word" aria-hidden="true">Ceviche House</p>
      <div class="ft__cols">
        {LOCATIONS.map((l) => <div><h3>{l.house[lang]}</h3><address>{l.street}<br />{l.district}, Lima</address></div>)}
        <div>
          <h3>{s.follow}</h3>
          <ul>
            {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
            <li><a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a></li>
            <li><a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
        <div>
          <h3>{s.menus}</h3>
          <ul>
            <li><a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a></li>
            <li><a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a></li>
            <li><a href={switchHref} hreflang={other}>{s.switchTo}</a></li>
          </ul>
        </div>
      </div>
      <p class="ft__legal"><span>{c.fin}</span><span>© {new Date().getFullYear()} Ceviche House · Lima, Perú. {s.rights}</span></p>
    </div>
  </footer>

  <aside class="mbar" aria-label={s.reserveWa}>
    <a class="btn btn--choclo" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{c.reserve}</a>
    <a class="btn btn--ghost" href="#carta">{c.nav.carta}</a>
  </aside>
</Base>

<style is:global>
  .cD {
    --bg: var(--parte-papel); --fg: var(--parte-mandil); --mut: var(--parte-mut); --line: rgb(17 20 23 / .22);
    --disp: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
    --sten: 'Big Shoulders Stencil Display Variable', 'Big Shoulders Display Variable', sans-serif;
    --sans: 'Source Sans 3 Variable', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.55 var(--sans);
  }
  .cD ::selection { background: var(--parte-choclo); color: var(--parte-mandil); }
  .cD :focus-visible { outline: 3px solid var(--parte-toldo); outline-offset: 3px; }
  .cD .g { max-width: var(--max); margin: auto; padding-inline: var(--gut); display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 900px) { .cD .g { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25rem; } }
  .cD i { font-style: normal; }
  .cD section[id] { scroll-margin-top: 6.2rem; }
  .cD .k { font: 500 .74rem/1.3 var(--mono); letter-spacing: .02em; text-transform: uppercase; color: var(--parte-rocoto-txt); display: flex; align-items: center; gap: .6rem; }
  .cD .k::before { content: ''; width: 1.6rem; height: 2px; background: currentColor; }
  .cD .k--light { color: var(--parte-choclo); }
  .cD .k--mandil { color: var(--parte-mandil); }
  .cD .h2 { font: 800 clamp(2.8rem, 6.4vw, 5.6rem)/.86 var(--disp); text-transform: uppercase; letter-spacing: -.005em; text-wrap: balance; }

  /* Buttons: square, flat, typographic */
  .cD .btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 48px; padding: .7rem 1.2rem; border: 2px solid transparent; border-radius: 0; font: 500 .82rem/1 var(--mono); text-transform: uppercase; letter-spacing: .02em; text-decoration: none; transition: background var(--dur), color var(--dur), border-color var(--dur); }
  .cD .btn svg { transition: transform var(--dur) var(--ease); }
  .cD .btn:hover svg { transform: translateX(3px); }
  .cD .btn--sm { min-height: 44px; padding: .55rem .9rem; font-size: .76rem; }
  .cD .btn--mandil { background: var(--parte-mandil); color: var(--parte-papel); }
  .cD .btn--mandil:hover { background: var(--parte-rocoto); color: var(--parte-mandil); }
  .cD .btn--choclo { background: var(--parte-choclo); color: var(--parte-mandil); }
  .cD .btn--choclo:hover { background: var(--parte-papel); }
  .cD .btn--line { border-color: var(--parte-mandil); color: var(--parte-mandil); }
  .cD .btn--line:hover { background: var(--parte-mandil); color: var(--parte-papel); }
  .cD .btn--ghost { border-color: rgb(247 246 242 / .35); color: var(--parte-papel); }

  /* Header */
  .cD .hd { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 2px solid var(--fg); }
  .cD .strip { display: flex; justify-content: space-between; gap: 1rem; padding: .35rem var(--gut); background: var(--parte-mandil); color: var(--parte-papel); font: 400 .7rem/1.3 var(--mono); text-transform: uppercase; letter-spacing: .03em; }
  .cD .strip__r { display: none; }
  @media (min-width: 700px) { .cD .strip__r { display: inline; color: var(--parte-choclo); } }
  .cD .bar { max-width: none; padding: .45rem var(--gut); display: flex; align-items: center; gap: 1rem; }
  .cD .brand { font: 900 1.7rem/1 var(--disp); text-transform: uppercase; text-decoration: none; letter-spacing: .005em; margin-right: auto; white-space: nowrap; }
  .cD .nav { display: none; gap: .2rem; }
  .cD .nav a { display: flex; align-items: baseline; gap: .3rem; padding: .7rem .6rem; font: 500 .76rem/1 var(--mono); text-transform: uppercase; text-decoration: none; border-bottom: 3px solid transparent; transition: border-color var(--dur), color var(--dur); }
  .cD .nav a i { color: var(--mut); font-size: .68rem; }
  .cD .nav a:hover { border-color: var(--line); }
  .cD .nav a[aria-current='true'] { border-color: var(--parte-rocoto); }
  .cD .nav a[aria-current='true'] i { color: var(--parte-rocoto-txt); }
  .cD .lang { font: 500 .76rem/1 var(--mono); padding: .9rem .4rem; text-decoration: none; }
  .cD .bar__cta { display: none; min-height: 42px; }
  .cD .mbtn { min-height: 44px; padding: 0 .9rem; border: 2px solid var(--fg); background: transparent; font: 500 .78rem/1 var(--mono); text-transform: uppercase; }
  .cD .mbtn__c, .cD .mbtn[aria-expanded='true'] .mbtn__o { display: none; }
  .cD .mbtn[aria-expanded='true'] .mbtn__c { display: inline; }
  @media (min-width: 1100px) { .cD .nav, .cD .bar__cta { display: flex; } .cD .mbtn { display: none; } }

