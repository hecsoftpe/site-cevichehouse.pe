---
/** A photo with technical callouts that point only at ingredients that are
 *  actually visible in the frame. The frame keeps the photo's native ratio so
 *  the coordinates (percent of the image) never drift. On small screens the
 *  labels collapse to numbered dots plus a legend. */
import type { ImageMetadata } from 'astro';
import Photo from '../shared/Photo.astro';
interface Pt { x: number; y: number; label: string; side?: 'l' | 'r' }
interface Props { src: ImageMetadata; alt: string; points: Pt[]; title: string; note: string; sizes?: string }
const { src, alt, points, title, note, sizes = '100vw' } = Astro.props;
---
<figure class="ann">
  <div class="ann__frame" style={`aspect-ratio:${src.width}/${src.height}`}>
    <Photo src={src} alt={alt} sizes={sizes} />
    {points.map((p, i) => (
      <span class:list={['ann__pt', `ann__pt--${p.side ?? 'r'}`]} style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">
        <i>{i + 1}</i><b>{p.label}</b>
      </span>
    ))}
  </div>
  <figcaption class="ann__cap">
    <span class="ann__t">{title}</span>
    <ol>{points.map((p) => <li>{p.label}</li>)}</ol>
    <span class="ann__n">{note}</span>
  </figcaption>
</figure>
