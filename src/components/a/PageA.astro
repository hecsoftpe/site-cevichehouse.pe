---
/**
 * Concept A — Pacific Editorial ("La crónica").
 * A food-magazine feature: cover, lede, a dark spread for the signature dishes,
 * a printed carta, a photo notebook. Newsreader + Instrument Sans.
 */
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../../styles/tokens.css';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Fish from '../shared/Fish.astro';
import Photo from '../shared/Photo.astro';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { P } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const nav = [
  ['#story', s.nav.story], ['#dishes', s.nav.menu], ['#gallery', s.nav.gallery],
  ['#reviews', s.nav.reviews], ['#locations', s.nav.locations],
] as const;
const name = (o: { es: string; en: string }) => o[lang];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII'];
const es = lang === 'es';
---
<Base lang={lang} path={path} bodyClass="cA" indexable={indexable} canonicalPath={canonicalPath} themeColor="#f7f3ec">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <div class="hd__in">
      <a class="brand" href="#top" aria-label="Ceviche House">
        <span class="brand__w">Ceviche House</span>
        <span class="brand__s">Lima</span>
      </a>
      <nav class="hd__nav" aria-label={es ? 'Principal' : 'Main'}>
        {nav.map(([h, l]) => <a href={h}>{l}</a>)}
      </nav>
      <div class="hd__act">
        <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={s.switchLabel}>{other.toUpperCase()}</a>
        <a class="btn btn--ink btn--sm hd__cta" href={wa} target="_blank" rel="noopener">{s.reserve}</a>
        <button class="burger" type="button" data-nav-toggle aria-controls="a-menu" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="ov" id="a-menu">
    <nav class="ov__nav" aria-label={es ? 'Móvil' : 'Mobile'}>
      {nav.map(([h, l], i) => <a href={h}><i>{roman[i]}.</i>{l}</a>)}
    </nav>
    <div class="ov__foot">
      <a class="btn btn--aji" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      <a class="ov__lang" href={switchHref} hreflang={other}>{s.switchTo}</a>
    </div>
  </div>

  <main id="main">
    <!-- COVER -->
    <section class="cover" id="top">
      <div class="cover__text">
        <p class="eyebrow">{s.eyebrow}</p>
        <h1 class="cover__title">{es
          ? <Fragment>El Pacífico peruano, <em>servido al momento.</em></Fragment>
          : <Fragment>The Peruvian Pacific, <em>made to order.</em></Fragment>}</h1>
        <p class="cover__lead">{s.heroLead}</p>
        <div class="cover__cta">
          <a class="btn btn--ink" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveLong}</a>
          <a class="link-arrow" href="#menu">{s.exploreMenu}<Icon name="arrow" size={18} /></a>
        </div>
        <dl class="dateline">
          {LOCATIONS.map((l) => <div><dt>{l.name}</dt><dd>{l.street}</dd></div>)}
        </dl>
      </div>
      <figure class="cover__fig">
        <div class="cover__img"><Photo src={P.ceviche.src} alt={P.ceviche[lang]} eager sizes="(min-width: 1024px) 52vw, 100vw" position={P.ceviche.focus} /></div>
        <figcaption>{P.ceviche[lang]}.</figcaption>
      </figure>
    </section>

    <!-- STORY: the lede -->
    <section class="story" id="story">
      <p class="sec-label" data-reveal><span>I.</span>{s.storyKicker}</p>
      <div class="story__grid">
        <h2 class="h2 story__title" data-reveal>{s.storyTitle}</h2>
        <p class="story__lede" data-reveal>{s.storyP1}</p>
        <div class="story__body" data-reveal>
          <p>{s.storyP2}</p>
          <p>{s.storyP3}</p>
        </div>
        <figure class="story__fig" data-reveal>
          <div class="story__img"><Photo src={P.mariscosDetalle.src} alt={P.mariscosDetalle[lang]} sizes="(min-width: 900px) 300px, 70vw" position={P.mariscosDetalle.focus} /></div>
          <figcaption>{P.mariscosDetalle[lang]}.</figcaption>
        </figure>
        <ol class="story__notes" data-reveal>
          {s.pillars.map((p) => <li><p><b>{p.t}.</b> {p.d}</p></li>)}
        </ol>
      </div>
      <blockquote class="pull" data-reveal><p>{s.quote}</p></blockquote>
    </section>

    <!-- SIGNATURE DISHES: dark spread -->
    <section class="spread" id="dishes">
      <figure class="spread__fig">
        <div class="spread__img"><Photo src={P.mariscos.src} alt={P.mariscos[lang]} sizes="(min-width: 1024px) 44vw, 100vw" position={P.mariscos.focus} /></div>
        <figcaption>{P.mariscos[lang]}.</figcaption>
      </figure>
      <div class="spread__text">
        <p class="sec-label sec-label--light" data-reveal><span>II.</span>{s.dishesKicker}</p>
        <h2 class="h2" data-reveal>{s.dishesTitle}</h2>
        <p class="spread__lead" data-reveal>{s.dishesLead}</p>
        <ol class="dlist">
          {dishes.map((d) => (
            <li data-reveal>
              <div class="dlist__row"><h3>{d.name}</h3><span class="dlist__price">{d.price}</span></div>
              <p>{d.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FULL MENU: printed carta -->
    <section class="carta" id="menu" data-menu data-menu-default="ceviches">
      <div class="carta__paper">
        <header class="carta__head">
          <Fish class="carta__fish" size={76} />
          <h2 class="h2">{s.fullMenuTitle}</h2>
          <p class="carta__lead">{s.fullMenuLead}</p>
          <p class="carta__pdf">
            <a href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={16} />{s.menuPdf}</a>
            <a href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={16} />{s.menuPdfOther}</a>
          </p>
        </header>
        <div class="carta__tabs" role="group" aria-label={s.fullMenuTitle}>
          <button type="button" data-filter="all" aria-pressed="true">{s.allCats}</button>
          {MENU.map((c) => <button type="button" data-filter={c.id} aria-pressed="false">{name(c)}</button>)}
        </div>
        <div class="carta__cols">
          {MENU.map((c, ci) => (
            <section class="carta__cat" data-cat={c.id} aria-labelledby={`a-cat-${c.id}`}>
              <h3 id={`a-cat-${c.id}`}><span>{roman[ci]}</span>{name(c)}</h3>
              <ul>
                {c.items.map((it) => (
                  <li>
                    <span class="carta__name">{name(it)}{(es ? it.subEs : it.subEn) && <small>{es ? it.subEs : it.subEn}</small>}</span>
                    <span class="carta__dots" aria-hidden="true"></span>
                    <span class="carta__price">{priceOf(it, lang)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="carta__note">{s.menuNote}</p>
      </div>
    </section>

    <!-- GALLERY: contact sheet -->
    <section class="nb" id="gallery">
      <p class="sec-label" data-reveal><span>III.</span>{s.galleryKicker}</p>
      <div class="nb__grid">
        <div class="nb__intro" data-reveal>
          <h2 class="h2">{s.galleryTitle}</h2>
          <p>{s.galleryLead}</p>
          {SOCIAL.instagram && <a class="link-arrow" href={SOCIAL.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} />{SOCIAL.instagramHandle}</a>}
          <p class="nb__more">
            <a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a>
            <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
          </p>
        </div>
        <ul class="nb__sheet">
          {[P.ceviche, P.mariscosDetalle, P.cevicheDetalle, P.mariscos].map((g, i) => (
            <li class={`nb__f nb__f--${i}`} data-reveal>
              <a href={g.src.src} data-lightbox data-alt={g[lang]}><Photo src={g.src} alt={g[lang]} sizes="(min-width: 900px) 26vw, 50vw" position={g.focus} /></a>
              <p class="nb__cap"><b>{String(i + 1).padStart(2, '0')}</b> {g[lang]}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- REVIEWS: slim band -->
    <section class="rev" id="reviews">
      <div class="rev__in">
        <div class="rev__head" data-reveal>
          <p class="sec-label sec-label--light"><span>IV.</span>{s.reviewsKicker}</p>
          <h2 class="h2">{s.reviewsTitle}</h2>
          <p>{s.reviewsLead}</p>
        </div>
        <ul class="rev__list" data-reveal>
          {REVIEWS.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener">
                <span class="rev__plat">{s.platform[r.platform]}</span>
                <span class="rev__loc">{LOCATIONS.find((l) => l.id === r.location)!.name}</span>
                {r.rating != null && <span class="rev__score">{r.rating.toFixed(1)} {s.ratingOf}</span>}
                <Icon name="external" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- LOCATIONS -->
    <section class="loc" id="locations">
      <p class="sec-label" data-reveal><span>V.</span>{s.locationsKicker}</p>
      <h2 class="h2 loc__title" data-reveal>{s.locationsTitle}</h2>
      <div class="loc__grid">
        {LOCATIONS.map((l) => (
          <article class="loc__card" data-reveal>
            <h3 class="loc__name">{l.name}</h3>
            <p class="loc__note">{l.note[lang]}</p>
            <address>{l.street}<br />{l.district}, Lima</address>
            <p class="loc__hours">{l.hours ? l.hours[lang] : s.hoursTbd}</p>
            <div class="loc__btns">
              <a class="btn btn--ink btn--sm" href={whatsappLink(lang, l.id)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{s.reserveHere} {l.name}</a>
              <a class="btn btn--line btn--sm" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener">{s.directions}</a>
              <a class="btn btn--line btn--sm" href={`tel:${PHONE_E164}`}>{s.call}</a>
            </div>
            <div class="loc__map">
              <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`${es ? 'Mapa' : 'Map'} — Ceviche House ${l.name}`}>
                <span>{s.loadMap}</span><small>{s.mapPrivacy}</small>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="ft__cta">
      <h2 class="ft__title">{s.footerReserve}</h2>
      <p>{s.footerReserveLead}</p>
      <a class="btn btn--aji" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
    </div>
    <div class="ft__grid">
      <div>
        <p class="brand brand--ft"><span class="brand__w">Ceviche House</span></p>
        <p class="ft__tag">{s.footerTag}</p>
      </div>
      {LOCATIONS.map((l) => (
        <div><h3>{l.name}</h3><address>{l.street}<br />{l.district}, Lima</address></div>
      ))}
      <div>
        <h3>{s.follow}</h3>
        <ul>
          <li><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></li>
          {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
          <li><a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a></li>
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>
      <div>
        <h3>{s.menus}</h3>
        <ul>
          <li><a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a></li>
          <li><a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a></li>
          <li><a href={switchHref} hreflang={other}>{s.switchTo}</a></li>
        </ul>
      </div>
    </div>
    <p class="ft__legal">© {new Date().getFullYear()} Ceviche House · Lima, Perú. {s.rights}</p>
  </footer>

  <aside aria-label={s.reserveWa}><a class="fab" href={wa} target="_blank" rel="noopener" aria-label={s.reserveWa}><Icon name="whatsapp" size={26} /></a></aside>
</Base>

<style is:global>
  .cA {
    --bg: var(--ivory-50); --paper: #fcfaf6; --fg: var(--ink-900); --muted: #5b5a54; --line: rgb(15 30 38 / .16);
    --accent: var(--aji-700); --accent-soft: var(--aji-200);
    --serif: 'Newsreader Variable', Georgia, serif; --sans: 'Instrument Sans Variable', system-ui, sans-serif;
    background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.62 var(--sans);
  }
  .cA ::selection { background: var(--ink-900); color: var(--ivory-50); }
  .cA :focus-visible { outline-color: var(--cobalt-500); }
  .cA .h2 { font: 360 clamp(2.1rem, 4.6vw, 3.9rem)/1.04 var(--serif); letter-spacing: -.018em; text-wrap: balance; }
  .cA .eyebrow { font: 500 .8rem/1.4 var(--sans); letter-spacing: .04em; color: var(--muted); }
  .cA .sec-label { display: flex; align-items: baseline; gap: .6rem; font: 500 .8rem/1 var(--sans); letter-spacing: .04em; color: var(--muted); padding-top: 1rem; border-top: 1px solid var(--line); margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cA .sec-label span { font: italic 400 1.35rem/1 var(--serif); color: var(--accent); letter-spacing: 0; }
  .cA .sec-label--light { color: rgb(247 243 236 / .7); border-color: rgb(247 243 236 / .2); }
  .cA .sec-label--light span { color: var(--accent-soft); }

  /* Buttons: squared, quiet */
  .cA .btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 48px; padding: .8rem 1.35rem; border-radius: 2px; font: 600 .95rem/1 var(--sans); text-decoration: none; border: 1px solid transparent; transition: background var(--dur), color var(--dur), border-color var(--dur); }
  .cA .btn--sm { min-height: 44px; padding: .6rem 1rem; font-size: .88rem; }
  .cA .btn--ink { background: var(--ink-900); color: var(--ivory-50); }
  .cA .btn--ink:hover { background: var(--ink-700); }
  .cA .btn--aji { background: var(--aji-500); color: #fff; }
  .cA .btn--aji:hover { background: var(--aji-700); }
  .cA .btn--line { border-color: var(--line); color: var(--fg); background: transparent; }
  .cA .btn--line:hover { border-color: var(--fg); }
  .cA .link-arrow { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-weight: 600; text-decoration: none; border-bottom: 1px solid currentColor; padding: 0 .1rem; }
  .cA .link-arrow svg { transition: transform var(--dur) var(--ease); }
  .cA .link-arrow:hover svg { transform: translateX(4px); }

  /* Header */
  .cA .hd { position: fixed; inset: 0 0 auto; z-index: 50; background: var(--bg); box-shadow: 0 1px 0 var(--line); }
  .cA .hd__in { max-width: var(--max); margin: auto; padding: .8rem var(--gut); display: flex; align-items: center; gap: 2rem; }
  .cA .brand { display: inline-flex; align-items: baseline; gap: .55rem; text-decoration: none; color: var(--fg); white-space: nowrap; }
  .cA .brand__w { font: italic 450 1.45rem/1 var(--serif); letter-spacing: -.01em; }
  .cA .brand__s { font: 500 .72rem/1 var(--sans); color: var(--muted); }
  .cA .hd__nav { display: none; gap: 1.7rem; margin-inline: auto; }
  .cA .hd__nav a { font-size: .92rem; text-decoration: none; padding: .6rem 0; background: linear-gradient(currentColor, currentColor) 0 85% / 0 1px no-repeat; transition: background-size var(--dur) var(--ease); }
  .cA .hd__nav a:hover { background-size: 100% 1px; }
  .cA .hd__act { display: flex; align-items: center; gap: .75rem; margin-left: auto; }
  .cA .lang { font: 600 .8rem/1 var(--sans); letter-spacing: .06em; text-decoration: none; padding: .9rem .5rem; color: var(--muted); }
  .cA .lang:hover { color: var(--fg); }
  .cA .hd__cta { display: none; }
  .cA .burger { width: 46px; height: 46px; border: 0; background: transparent; display: grid; place-content: center; gap: 7px; position: relative; z-index: 61; }
  .cA .burger span { display: block; width: 24px; height: 1.5px; background: var(--fg); transition: transform var(--dur); }
  .cA .burger[aria-expanded='true'] span { background: var(--ivory-50); }
  .cA .burger[aria-expanded='true'] span:first-child { transform: translateY(4.25px) rotate(45deg); }
  .cA .burger[aria-expanded='true'] span:last-child { transform: translateY(-4.25px) rotate(-45deg); }
  @media (min-width: 1024px) { .cA .hd__nav, .cA .hd__cta { display: flex; } .cA .burger { display: none; } }

  .cA .ov { position: fixed; inset: 0; z-index: 60; background: var(--ink-900); color: var(--ivory-50); padding: 6rem var(--gut) 2rem; display: flex; flex-direction: column; justify-content: space-between; visibility: hidden; opacity: 0; transition: opacity .35s, visibility .35s; }
  .cA .ov[data-open] { visibility: visible; opacity: 1; }
  .cA .ov__nav { display: grid; }
  .cA .ov__nav a { font: 340 clamp(2rem, 9vw, 3rem)/1.2 var(--serif); text-decoration: none; display: flex; align-items: baseline; gap: 1rem; padding: .35rem 0; border-bottom: 1px solid rgb(247 243 236 / .12); }
  .cA .ov__nav i { font: italic 400 1rem/1 var(--serif); color: var(--accent-soft); min-width: 2.5ch; }
  .cA .ov__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .cA .ov__lang { font-weight: 600; padding: .8rem 0; }
  html[data-nav-open] .cA .hd { z-index: 70; background: transparent; box-shadow: none; }
  html[data-nav-open] .cA .fab { display: none; }
  .cA:has(.ov[data-open]) .brand { color: var(--ivory-50); }
  .cA:has(.ov[data-open]) .lang { visibility: hidden; }

  /* Cover */
  .cA .cover { display: grid; grid-template-columns: minmax(0, 1fr); padding-top: 4.4rem; }
  .cA .cover__fig { order: -1; }
  .cA .cover__img { aspect-ratio: var(--r-portrait); overflow: hidden; background: var(--ink-900); }
  .cA .cover__fig figcaption { font: italic 400 .85rem/1.4 var(--serif); color: var(--muted); padding: .6rem var(--gut) 0; }
  .cA .cover__text { padding: 2rem var(--gut) 3rem; }
  .cA .cover__title { font: 320 clamp(2.8rem, 7.6vw, 6.2rem)/.98 var(--serif); letter-spacing: -.03em; margin: 1.1rem 0 1.4rem; text-wrap: balance; }
  .cA .cover__title em { font-style: italic; font-weight: 300; color: var(--accent); }
  .cA .cover__lead { max-width: 32rem; font-size: 1.1rem; color: var(--muted); }
  .cA .cover__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 2rem; }
  .cA .dateline { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); max-width: 32rem; }
  .cA .dateline dt { font: italic 450 1.15rem/1.2 var(--serif); }
  .cA .dateline dd { margin: 0; font-size: .88rem; color: var(--muted); }
  @media (max-width: 1023px) { .cA .cover__img { aspect-ratio: 1 / 1; } }
  @media (min-width: 1024px) {
    .cA .cover { grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); min-height: 100svh; max-height: 1100px; padding-top: 4.2rem; }
    .cA .cover__fig { order: 0; display: grid; grid-template-rows: 1fr auto; padding-bottom: 1.5rem; }
    .cA .cover__img { aspect-ratio: auto; height: 100%; }
    .cA .cover__fig figcaption { padding-inline: 0; }
    .cA .cover__text { align-self: end; padding: 4rem clamp(2rem, 5vw, 5rem) 4.5rem max(var(--gut), calc((100vw - var(--max)) / 2 + var(--gut))); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cA .cover__img img { animation: aSettle 1.6s var(--ease) both; }
    @keyframes aSettle { from { transform: scale(1.04); opacity: .6; } to { transform: none; opacity: 1; } }
  }

  /* Story */
  .cA .story, .cA .nb, .cA .loc { max-width: var(--max); margin: auto; padding: var(--section) var(--gut); }
  .cA .story__grid { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
  .cA .story__lede { font: 360 clamp(1.3rem, 2.2vw, 1.65rem)/1.45 var(--serif); max-width: 36rem; }
  .cA .story__body { display: grid; gap: 1rem; color: var(--muted); max-width: 34rem; }
  .cA .story__fig { max-width: 300px; }
  .cA .story__img { aspect-ratio: 1; overflow: hidden; }
  .cA .story figcaption { font: italic 400 .85rem/1.4 var(--serif); color: var(--muted); margin-top: .6rem; }
  .cA .story__notes { display: grid; gap: .9rem; counter-reset: n; max-width: 30rem; }
  .cA .story__notes li { counter-increment: n; display: grid; grid-template-columns: 2rem minmax(0, 1fr); font-size: .97rem; color: var(--muted); padding-top: .9rem; border-top: 1px solid var(--line); }
  .cA .story__notes li::before { content: counter(n, lower-roman) '.'; font: italic 400 1rem/1.5 var(--serif); color: var(--accent); }
  .cA .story__notes b { color: var(--fg); font-weight: 600; }
