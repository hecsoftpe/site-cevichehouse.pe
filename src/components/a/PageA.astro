---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/inter';
import Base from '../../layouts/Base.astro';
import Icon from '../shared/Icon.astro';
import Fish from '../shared/Fish.astro';
import Photo from '../shared/Photo.astro';
import { type Lang, LOCATIONS, SOCIAL, MENU_PDF, PHONE_DISPLAY, PHONE_E164, whatsappLink, mapsDirections, mapsEmbed } from '../../data/site';
import { MENU, priceOf, signatureItems } from '../../data/menu';
import { GALLERY, PHOTOS } from '../../data/gallery';
import { REVIEWS } from '../../data/reviews';
import { t, url } from '../../i18n';

interface Props { lang: Lang; path: string; indexable?: boolean; canonicalPath?: string }
const { lang, path, indexable, canonicalPath } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const switchHref = url(other === 'en' ? `en/${path}` : path);
const wa = whatsappLink(lang);
const dishes = signatureItems(lang);
const nav = [
  ['#story', s.nav.story], ['#dishes', s.nav.menu], ['#gallery', s.nav.gallery],
  ['#reviews', s.nav.reviews], ['#locations', s.nav.locations],
] as const;
const name = (o: { es: string; en: string }) => o[lang];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII'];
---
<Base lang={lang} path={path} bodyClass="cA" indexable={indexable} canonicalPath={canonicalPath} themeColor="#f4eee3">
  <a class="skip" href="#main">{s.skip}</a>

  <header class="hd" data-header>
    <div class="hd__in">
      <a class="brand" href="#top" aria-label="Ceviche House — inicio">
        <span class="brand__c">Ceviche</span><span class="brand__h">House</span>
      </a>
      <nav class="hd__nav" aria-label="Principal">
        <a href="#top">{s.nav.home}</a>
        {nav.map(([h, l]) => <a href={h}>{l}</a>)}
      </nav>
      <div class="hd__act">
        <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={s.switchLabel}>
          <span aria-current={lang === 'es' ? 'true' : undefined}>ES</span><span aria-hidden="true">/</span><span aria-current={lang === 'en' ? 'true' : undefined}>EN</span>
        </a>
        <a class="btn btn--coral btn--sm hd__cta" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{s.reserve}</a>
        <button class="burger" type="button" data-nav-toggle aria-controls="a-menu" aria-expanded="false" aria-label={s.openMenu} data-label-open={s.openMenu} data-label-close={s.closeMenu}>
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="ov" id="a-menu" aria-label={s.openMenu}>
    <nav class="ov__nav" aria-label="Móvil">
      <a href="#top"><i>00</i>{s.nav.home}</a>
      {nav.map(([h, l], i) => <a href={h}><i>{String(i + 1).padStart(2, '0')}</i>{l}</a>)}
    </nav>
    <div class="ov__foot">
      <a class="btn btn--coral" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
      <a class="ov__lang" href={switchHref} hreflang={other}>{s.switchTo}</a>
    </div>
  </div>

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero__text">
        <p class="kicker"><span class="kicker__no">Nº 01</span> {s.eyebrow}</p>
        <h1 class="hero__title">{lang === 'es'
          ? <Fragment>El Pacífico peruano, <em>servido al momento.</em></Fragment>
          : <Fragment>The Peruvian Pacific, <em>made to order.</em></Fragment>}</h1>
        <p class="hero__lead">{s.heroLead}</p>
        <div class="hero__cta">
          <a class="btn btn--ink" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveLong}</a>
          <a class="btn btn--line" href="#menu">{s.exploreMenu}<Icon name="arrow" size={18} /></a>
        </div>
        <ul class="hero__loc">
          {LOCATIONS.map((l) => <li><Icon name="pin" size={16} /> <b>{l.name}</b> · {l.street}</li>)}
        </ul>
      </div>
      <figure class="hero__fig">
        <div class="hero__img"><Photo src={PHOTOS.ceviche} alt={GALLERY[0][lang]} eager sizes="(min-width: 1024px) 55vw, 100vw" widths={[480, 760, 1080]} position="center 40%" /></div>
        <figcaption><span>Fig. 1</span> {lang === 'es' ? 'Ceviche de nuestra carta.' : 'Ceviche from our menu.'}</figcaption>
      </figure>
    </section>

    <!-- STORY -->
    <section class="story" id="story">
      <header class="chap" data-reveal><span class="chap__n">I.</span><p class="chap__k">{s.storyKicker}</p></header>
      <div class="story__grid">
        <h2 class="h2 story__title" data-reveal>{s.storyTitle}</h2>
        <div class="story__body" data-reveal>
          <p class="dropcap">{s.storyP1}</p>
          <p>{s.storyP2}</p>
          <p>{s.storyP3}</p>
        </div>
        <figure class="story__fig" data-reveal>
          <Photo src={PHOTOS.mariscos} alt={GALLERY[2][lang]} sizes="(min-width: 1024px) 38vw, 100vw" />
          <figcaption><span>Fig. 2</span> {GALLERY[2][lang]}.</figcaption>
        </figure>
        <blockquote class="pull" data-reveal><p>“{s.quote}”</p></blockquote>
      </div>
      <ol class="pillars">
        {s.pillars.map((p, i) => (
          <li data-reveal><span class="pillars__n">{roman[i]}</span><h3>{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
    </section>

    <!-- SIGNATURE DISHES -->
    <section class="dishes" id="dishes">
      <header class="chap chap--light" data-reveal><span class="chap__n">II.</span><p class="chap__k">{s.dishesKicker}</p></header>
      <div class="dishes__head" data-reveal>
        <h2 class="h2">{s.dishesTitle}</h2>
        <p>{s.dishesLead}</p>
      </div>
      <ol class="dlist">
        {dishes.map((d, i) => (
          <li class="dlist__item" data-reveal>
            <span class="dlist__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="dlist__main">
              <p class="dlist__cat">{d.category}</p>
              <h3 class="dlist__name">{d.name}</h3>
              <p class="dlist__desc">{d.desc}</p>
            </div>
            <span class="dlist__price">{d.price}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- FULL MENU -->
    <section class="carta" id="menu" data-menu>
      <div class="carta__paper">
        <header class="carta__head">
          <Fish class="carta__fish" size={88} />
          <p class="kicker">{s.fullMenuKicker}</p>
          <h2 class="h2">{s.fullMenuTitle}</h2>
          <p class="carta__lead">{s.fullMenuLead}</p>
          <div class="carta__pdf">
            <a class="btn btn--ink btn--sm" href={MENU_PDF[lang]} target="_blank" rel="noopener"><Icon name="doc" size={16} />{s.menuPdf}</a>
            <a class="btn btn--line btn--sm" href={MENU_PDF[other]} target="_blank" rel="noopener" hreflang={other}><Icon name="doc" size={16} />{s.menuPdfOther}</a>
          </div>
        </header>
        <div class="carta__tabs" role="group" aria-label={s.fullMenuTitle}>
          <button type="button" data-filter="all" aria-pressed="true">{s.allCats}</button>
          {MENU.map((c) => <button type="button" data-filter={c.id} aria-pressed="false">{name(c)}</button>)}
        </div>
        <div class="carta__cols">
          {MENU.map((c, ci) => (
            <section class="carta__cat" data-cat={c.id} aria-labelledby={`a-cat-${c.id}`}>
              <h3 id={`a-cat-${c.id}`}><span>{roman[ci]}</span>{name(c)}</h3>
              <ul>
                {c.items.map((it) => (
                  <li>
                    <span class="carta__name">{name(it)}{(lang === 'es' ? it.subEs : it.subEn) && <small>{lang === 'es' ? it.subEs : it.subEn}</small>}</span>
                    <span class="carta__dots" aria-hidden="true"></span>
                    <span class="carta__price">{priceOf(it, lang)}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="carta__note">{lang === 'es' ? 'Precios en soles (S/).' : 'Prices in Peruvian soles (S/).'}</p>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="gal" id="gallery">
      <header class="chap" data-reveal><span class="chap__n">III.</span><p class="chap__k">{s.galleryKicker}</p></header>
      <div class="gal__head" data-reveal>
        <h2 class="h2">{s.galleryTitle}</h2>
        <p>{s.galleryLead}</p>
      </div>
      <div class="gal__grid">
        {GALLERY.map((g, i) => (
          <figure class={`gal__it gal__it--${i}`} data-reveal>
            {g.src ? (
              <a href={PHOTOS[g.key as 'ceviche' | 'mariscos'].src} data-lightbox data-alt={g[lang]} aria-label={g[lang]}>
                <Photo src={g.src} alt={g[lang]} sizes="(min-width: 1024px) 40vw, 100vw" />
              </a>
            ) : (
              <Photo src={null} alt={g[lang]} label={s.photoSoon} tone={i % 3 === 1 ? 'dark' : 'light'} />
            )}
          </figure>
        ))}
      </div>
      <p class="gal__follow" data-reveal>
        {s.galleryFollow}:
        <a href={SOCIAL.tiktok} target="_blank" rel="noopener"><Icon name="tiktok" size={18} /> TikTok</a>
        <a href={SOCIAL.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={18} /> Facebook</a>
        {SOCIAL.instagram && <a href={SOCIAL.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>}
      </p>
    </section>

    <!-- REVIEWS -->
    <section class="rev" id="reviews">
      <header class="chap chap--light" data-reveal><span class="chap__n">IV.</span><p class="chap__k">{s.reviewsKicker}</p></header>
      <div class="rev__head" data-reveal>
        <h2 class="h2">{s.reviewsTitle}</h2>
        <p>{s.reviewsLead}</p>
      </div>
      <div class="rev__grid">
        {REVIEWS.map((r) => (
          <article class="rev__card" data-reveal>
            <p class="rev__plat">{s.platform[r.platform]}</p>
            <h3 class="rev__loc">{LOCATIONS.find((l) => l.id === r.location)!.name}</h3>
            {r.rating != null ? (
              <p class="rev__score"><b>{r.rating.toFixed(1)}</b> <span>{s.ratingOf}{r.count != null && ` · ${r.count} ${s.reviewsCount}`}</span></p>
            ) : (
              <p class="rev__empty">{s.noRatingYet}</p>
            )}
            {r.platform === 'tripadvisor' && <p class="rev__note">{s.tripNote}</p>}
            {r.quotes.map((q) => <blockquote class="rev__q"><p>“{q.text}”</p><footer>— {q.author}, {q.date}</footer></blockquote>)}
            <div class="rev__links">
              <a href={r.url} target="_blank" rel="noopener">{s.readReviews} <Icon name="external" size={14} /></a>
              {r.writeUrl && <a href={r.writeUrl} target="_blank" rel="noopener">{s.writeReview}</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- LOCATIONS -->
    <section class="loc" id="locations">
      <header class="chap" data-reveal><span class="chap__n">V.</span><p class="chap__k">{s.locationsKicker}</p></header>
      <div class="loc__head" data-reveal>
        <h2 class="h2">{s.locationsTitle}</h2>
        <p>{s.locationsLead}</p>
      </div>
      <div class="loc__grid">
        {LOCATIONS.map((l) => (
          <article class="loc__card" data-reveal>
            <h3 class="loc__name">{l.name}</h3>
            <p class="loc__note">{l.note[lang]}</p>
            <address>{l.street}<br />{l.district}, Lima</address>
            <p class="loc__hours">{l.hours ? l.hours[lang] : s.hoursTbd}</p>
            <div class="loc__btns">
              <a class="btn btn--ink btn--sm" href={whatsappLink(lang, l.id)} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} />{s.reserveHere} {l.name}</a>
              <a class="btn btn--line btn--sm" href={mapsDirections(l.mapsQuery)} target="_blank" rel="noopener"><Icon name="pin" size={16} />{s.directions}</a>
              <a class="btn btn--line btn--sm" href={`tel:${PHONE_E164}`}><Icon name="phone" size={16} />{s.call}</a>
            </div>
            <div class="loc__map">
              <button type="button" data-map-load={mapsEmbed(l.mapsQuery, lang)} data-title={`Mapa — Ceviche House ${l.name}`}>
                <Icon name="pin" size={22} /><span>{s.loadMap}</span><small>{s.mapPrivacy}</small>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="ft__cta">
      <h2 class="ft__title">{s.footerReserve}</h2>
      <p>{s.footerReserveLead}</p>
      <a class="btn btn--coral" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{s.reserveWa}</a>
    </div>
    <div class="ft__grid">
      <div>
        <p class="brand brand--ft"><span class="brand__c">Ceviche</span><span class="brand__h">House</span></p>
        <p class="ft__tag">{s.footerTag}</p>
      </div>
      {LOCATIONS.map((l) => (
        <div><h3>{l.name}</h3><address>{l.street}<br />{l.district}, Lima</address></div>
      ))}
      <div>
        <h3>{s.follow}</h3>
        <ul>
          <li><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></li>
          <li><a href={SOCIAL.tiktok} target="_blank" rel="noopener">TikTok</a></li>
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a></li>
          {SOCIAL.instagram && <li><a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a></li>}
        </ul>
      </div>
      <div>
        <h3>{s.menus}</h3>
        <ul>
          <li><a href={MENU_PDF.es} target="_blank" rel="noopener">Carta (ES)</a></li>
          <li><a href={MENU_PDF.en} target="_blank" rel="noopener">Menu (EN)</a></li>
          <li><a href={switchHref} hreflang={other}>{s.switchTo}</a></li>
        </ul>
      </div>
    </div>
    <p class="ft__legal">© {new Date().getFullYear()} Ceviche House · Lima, Perú. {s.rights}</p>
  </footer>

  <a class="fab" href={wa} target="_blank" rel="noopener" aria-label={s.reserveWa}><Icon name="whatsapp" size={26} /></a>
</Base>

<style is:global>
  .cA {
    --ivory: #f4eee3; --sand: #e8dccb; --paper: #fbf8f2; --ocean: #0f2a44; --ocean-2: #1b3d5e;
    --coral: #a8401f; --coral-2: #f39a82; --ink: #1c2430; --muted: #5b6470;
    --serif: 'Fraunces Variable', Georgia, serif; --sans: 'Inter Variable', system-ui, sans-serif;
    --gut: clamp(1rem, 4vw, 3.5rem); --max: 1320px;
    background: var(--ivory); color: var(--ink); font: 400 1.0625rem/1.65 var(--sans);
  }
  .cA ::selection { background: var(--coral-2); color: #fff; }
  .cA .h2 { font: 360 clamp(2.2rem, 5.2vw, 4.4rem)/1.02 var(--serif); letter-spacing: -.02em; font-variation-settings: 'opsz' 144, 'SOFT' 40; color: var(--ocean); }
  .cA .kicker { font: 600 .72rem/1.3 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--coral); }
  .cA .kicker__no { color: var(--ocean); margin-right: .5em; }

  /* Buttons */
  .cA .btn { display: inline-flex; align-items: center; gap: .55rem; min-height: 48px; padding: .8rem 1.4rem; border-radius: 999px; font: 600 .95rem/1 var(--sans); text-decoration: none; border: 1.5px solid transparent; transition: background .25s, color .25s, transform .25s; }
  .cA .btn:hover { transform: translateY(-2px); }
  .cA .btn--sm { min-height: 42px; padding: .6rem 1.05rem; font-size: .86rem; }
  .cA .btn--ink { background: var(--ocean); color: var(--ivory); }
  .cA .btn--ink:hover { background: var(--ocean-2); }
  .cA .btn--coral { background: var(--coral); color: #fff; }
  .cA .btn--coral:hover { background: #8c3216; }
  .cA .btn--line { border-color: currentColor; color: var(--ocean); }
  .cA .btn--line:hover { background: var(--ocean); color: var(--ivory); border-color: var(--ocean); }

  /* Header */
  .cA .hd { position: fixed; inset: 0 0 auto; z-index: 50; transition: background .35s, box-shadow .35s; }
  .cA .hd[data-scrolled] { background: color-mix(in srgb, var(--ivory) 92%, transparent); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgb(15 42 68 / .1); }
  .cA .hd__in { max-width: var(--max); margin: auto; padding: .9rem var(--gut); display: flex; align-items: center; gap: 2rem; }
  .cA .brand { display: inline-flex; align-items: baseline; gap: .3em; text-decoration: none; color: var(--ocean); font-family: var(--serif); }
  .cA .brand__c { font-size: 1.6rem; font-weight: 500; font-style: italic; letter-spacing: -.02em; }
  .cA .brand__h { font: 600 .68rem/1 var(--sans); letter-spacing: .32em; text-transform: uppercase; }
  .cA .hd__nav { display: none; gap: 1.8rem; margin-inline: auto; }
  .cA .hd__nav a { font-size: .9rem; text-decoration: none; color: var(--ink); position: relative; padding: .4rem 0; }
  .cA .hd__nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px; background: var(--coral); transition: right .3s; }
  .cA .hd__nav a:hover::after { right: 0; }
  .cA .hd__act { display: flex; align-items: center; gap: .9rem; margin-left: auto; }
  .cA .lang { display: inline-flex; gap: .3rem; font: 600 .78rem/1 var(--sans); letter-spacing: .1em; text-decoration: none; color: var(--muted); padding: .7rem .25rem; }
  .cA .lang [aria-current] { color: var(--ocean); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--coral); }
  .cA .hd__cta { display: none; }
  .cA .burger { width: 46px; height: 46px; border: 1px solid rgb(15 42 68 / .25); border-radius: 50%; background: transparent; display: grid; place-content: center; gap: 6px; position: relative; z-index: 61; }
  .cA .burger span { display: block; width: 18px; height: 1.5px; background: var(--ocean); transition: transform .3s; }
  .cA .burger[aria-expanded='true'] { border-color: rgb(244 238 227 / .4); }
  .cA .burger[aria-expanded='true'] span { background: var(--ivory); }
  .cA .burger[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .cA .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  @media (min-width: 1024px) { .cA .hd__nav, .cA .hd__cta { display: flex; } .cA .burger { display: none; } }

  /* Overlay menu */
  .cA .ov { position: fixed; inset: 0; z-index: 60; background: var(--ocean); color: var(--ivory); padding: 6.5rem var(--gut) 2rem; display: flex; flex-direction: column; justify-content: space-between; visibility: hidden; opacity: 0; transition: opacity .4s, visibility .4s; }
  .cA .ov[data-open] { visibility: visible; opacity: 1; }
  .cA .ov__nav { display: grid; gap: .25rem; }
  .cA .ov__nav a { font: 340 clamp(2.2rem, 10vw, 3.4rem)/1.15 var(--serif); text-decoration: none; display: flex; align-items: baseline; gap: 1rem; padding: .2rem 0; border-bottom: 1px solid rgb(244 238 227 / .12); }
  .cA .ov__nav i { font: 500 .75rem/1 var(--sans); font-style: normal; color: var(--coral-2); letter-spacing: .15em; }
  .cA .ov__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .cA .ov__lang { font-weight: 600; letter-spacing: .08em; padding: .8rem 0; }
  html[data-nav-open] .cA .hd { z-index: 70; background: transparent; box-shadow: none; backdrop-filter: none; }
  html[data-nav-open] .cA .fab { display: none; }
  .cA:has(.ov[data-open]) .brand { color: var(--ivory); }
  .cA:has(.ov[data-open]) .lang { visibility: hidden; }

  /* Hero */
  .cA .hero { max-width: var(--max); margin: auto; padding: 6.5rem var(--gut) 3rem; display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 1fr); }
  .cA .hero__title { font: 330 clamp(2.9rem, 8.4vw, 6.6rem)/.95 var(--serif); letter-spacing: -.035em; color: var(--ocean); margin: 1.2rem 0 1.5rem; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; }
  .cA .hero__title em { font-style: italic; color: var(--coral); font-weight: 300; }
  .cA .hero__lead { max-width: 34rem; font-size: 1.12rem; color: var(--muted); }
  .cA .hero__cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .cA .hero__loc { margin-top: 2.2rem; display: grid; gap: .4rem; font-size: .88rem; color: var(--muted); }
  .cA .hero__loc li { display: flex; align-items: center; gap: .35rem; }
  .cA .hero__loc b { color: var(--ocean); font-weight: 600; }
  .cA .hero__fig { position: relative; order: -1; margin-inline: calc(-1 * var(--gut)); }
  .cA .hero__fig figcaption { padding-inline: var(--gut); }
  @media (max-width: 1023px) { .cA .hero__img { aspect-ratio: 1; } .cA .hero { padding-top: 4.6rem; } }
  .cA .hero__img { aspect-ratio: 4 / 5; overflow: hidden; border-radius: 2px; }
  .cA .hero__img img { animation: aZoom 14s ease-out both; }
  @keyframes aZoom { from { transform: scale(1.08); } to { transform: scale(1); } }
  .cA figcaption { font: 400 .8rem/1.4 var(--sans); color: var(--muted); margin-top: .7rem; }
  .cA figcaption span { font-weight: 600; color: var(--coral); letter-spacing: .1em; text-transform: uppercase; font-size: .7rem; margin-right: .4rem; }
  @media (min-width: 1024px) {
    .cA .hero { grid-template-columns: 5fr 6fr; align-items: end; min-height: 100svh; padding-top: 8rem; gap: 4rem; }
    .cA .hero__text { padding-bottom: 3rem; }
    .cA .hero__fig { order: 0; margin-inline: 0; }
    .cA .hero__fig figcaption { padding-inline: 0; }
    .cA .hero__img { aspect-ratio: 5 / 6; }
    .cA .hero__fig::before { content: ''; position: absolute; inset: 2.5rem -1.5rem -1.5rem 2.5rem; background: var(--sand); z-index: -1; }
  }

  /* Chapters */
