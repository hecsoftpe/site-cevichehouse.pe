---
import { getImage } from 'astro:assets';
import { type Lang, DEFAULT_CONCEPT } from '../data/site';
import { t } from '../i18n';
import { restaurantJsonLd } from '../lib/seo';
import { PHOTOS } from '../data/gallery';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Site-relative path of this page, e.g. "concept-a/" (without lang prefix). */
  path: string;
  /** Path of the counterpart in the other language is derived from `path`. */
  bodyClass?: string;
  indexable?: boolean;
  canonicalPath?: string;
  themeColor?: string;
  jsonLd?: boolean;
  alternates?: boolean;
}
const { lang, path, bodyClass, themeColor = '#0f2a44', jsonLd = true, alternates = true } = Astro.props;
const s = t(lang);
const title = Astro.props.title ?? s.seoTitle;
const description = Astro.props.description ?? s.seoDesc;
// Until the owner picks a concept, the whole site stays out of search indexes.
const indexable = Astro.props.indexable ?? DEFAULT_CONCEPT !== null;

const site = Astro.site!;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const abs = (p: string) => new URL(base + p.replace(/^\//, ''), site).href;
const esPath = path;
const enPath = `en/${path}`;
const canonical = abs(Astro.props.canonicalPath ?? (lang === 'en' ? enPath : esPath));
const og = await getImage({ src: PHOTOS.ceviche, width: 1080, height: 566, fit: 'cover', position: 'center', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates && <Fragment>
      <link rel="alternate" hreflang="es-PE" href={abs(esPath)} />
      <link rel="alternate" hreflang="en" href={abs(enPath)} />
      <link rel="alternate" hreflang="x-default" href={abs(esPath)} />
    </Fragment>}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content="Ceviche House" />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={restaurantJsonLd(lang, canonical, ogUrl)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <dialog class="lightbox" data-lightbox-dialog aria-label={lang === 'es' ? 'Foto' : 'Photo'}>
      <figure>
        <img src="" alt="" />
        <figcaption></figcaption>
      </figure>
      <button type="button" class="lightbox__close" data-close aria-label={lang === 'es' ? 'Cerrar' : 'Close'}>×</button>
    </dialog>
    <script>import '../scripts/ui.ts';</script>
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; min-height: 100vh; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  img, picture, svg, iframe { display: block; max-width: 100%; }
  picture { width: 100%; height: 100%; }
  picture img { width: 100%; height: 100%; object-fit: cover; }
  :where(h1, h2, h3, p, figure, ul, ol, dl, dd, blockquote) { margin: 0; }
  :where(ul, ol) { padding: 0; list-style: none; }
  a { color: inherit; }
  button { font: inherit; color: inherit; cursor: pointer; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 3px solid #f2b705; outline-offset: 3px; border-radius: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 100; padding: .75rem 1rem; background: #111; color: #fff; text-decoration: none; }
  .skip:focus { top: 1rem; }
  html[data-nav-open] { overflow: hidden; }
  section[id] { scroll-margin-top: 5rem; }

  .js-reveal [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
  .js-reveal [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: min(92vw, 1100px); max-height: 92vh; }
  .lightbox::backdrop { background: rgb(5 12 20 / .88); }
  .lightbox figure { display: grid; gap: .75rem; }
  .lightbox img { max-height: 82vh; width: auto; margin-inline: auto; object-fit: contain; }
  .lightbox figcaption { color: #eee; font: 400 .95rem/1.4 system-ui, sans-serif; text-align: center; }
  .lightbox__close { position: fixed; top: 1rem; right: 1rem; width: 3rem; height: 3rem; border-radius: 50%; border: 0; background: #fff; color: #111; font-size: 1.8rem; line-height: 1; }
</style>
